{
  "name": "codex-harness-template",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable, lightweight Codex harness",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "docs:dev": "vitepress dev wiki",
    "docs:build": "npm run docs:index && npm run docs:check && vitepress build wiki",
    "docs:preview": "vitepress preview wiki",
    "docs:index": "node scripts/build-wiki-index.mjs",
    "docs:check": "node scripts/check-wiki.mjs",
    "harness:init": "node scripts/harness-init.mjs",
    "harness:check": "node scripts/harness-check.mjs",
    "harness:verify": "node scripts/harness-check.mjs --run-adapters",
    "test": "node --test tests/**/*.test.mjs"
  },
  "devDependencies": {
    "mermaid": "11.12.3",
    "vitepress": "1.6.4",
    "vue": "3.5.22"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
