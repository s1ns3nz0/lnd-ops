# Node.js dependencies and diagnostic output
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# Build and test output
coverage/
dist/
build/
.cache/
__pycache__/
*.pyc

# Local agent/runtime state. Plans and reports are committed provenance, not
# disposable output. Keep explicit placeholders for local-only directories.
.harness/runs/*
!.harness/runs/.gitkeep
.harness/cache/
.harness/graph-assets/
.re0/

# Local environment and editor state
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
windows-smoke.log

# Local wallet recovery notes. Never commit seed words or passwords.
/prhase
