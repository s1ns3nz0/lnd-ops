#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
profile=${1:-}
case "$profile" in
  regtest|testnet) ;;
  *) echo 'Usage: ops/deploy regtest|testnet [--monitoring] [--loop|--no-loop] [--router --router-external-ip HOST]' >&2; exit 2 ;;
esac
shift
monitoring_requested=false
loop_requested=false
loop_disabled=false
router_requested=false
router_external_ip=''
while (($#)); do
  option=$1
  case "$option" in
    --monitoring) $monitoring_requested && { echo 'duplicate --monitoring' >&2; exit 2; }; monitoring_requested=true; shift ;;
    --loop) $loop_requested && { echo 'duplicate --loop' >&2; exit 2; }; loop_requested=true; shift ;;
    --no-loop) $loop_disabled && { echo 'duplicate --no-loop' >&2; exit 2; }; loop_disabled=true; shift ;;
    --router) $router_requested && { echo 'duplicate --router' >&2; exit 2; }; router_requested=true; shift ;;
    --router-external-ip) [[ $# -ge 2 ]] || { echo '--router-external-ip requires HOST' >&2; exit 2; }; router_external_ip=$2; shift 2 ;;
    *) echo 'Usage: ops/deploy regtest|testnet [--monitoring] [--loop|--no-loop] [--router --router-external-ip HOST]' >&2; exit 2 ;;
  esac
done
[[ "$loop_requested" == false || "$loop_disabled" == false ]] || { echo 'choose only one of --loop or --no-loop' >&2; exit 2; }
[[ "$loop_requested" == false || "$profile" == testnet ]] || {
  echo 'Loop is supported only by the persistent testnet profile' >&2
  exit 2
}
[[ "$router_requested" == false || "$profile" == testnet ]] || { echo 'Router mode is supported only by the persistent testnet profile' >&2; exit 2; }
[[ "$router_requested" == false || -n "$router_external_ip" ]] || { echo 'Router mode requires --router-external-ip HOST' >&2; exit 2; }
[[ -z "$router_external_ip" || "$router_requested" == true ]] || { echo '--router-external-ip requires --router' >&2; exit 2; }
[[ -z "$router_external_ip" || "$router_external_ip" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] || { echo 'Router external host must be a bare DNS name or IP address' >&2; exit 2; }

export KUBECONFIG=${KUBECONFIG:-${XDG_STATE_HOME:-$HOME/.local/state}/lnd-ops/kubeconfig}
[[ -r "$KUBECONFIG" ]] || { echo "Kubeconfig missing: $KUBECONFIG; run ops/bootstrap" >&2; exit 1; }
kubectl get nodes >/dev/null
namespace=lnd-$profile
if [[ "$profile" == regtest ]]; then
  recovery_state=$(kubectl get namespace "$namespace" -o json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("metadata",{}).get("labels",{}).get("lnd-ops-recovery",""))' 2>/dev/null || true)
  [[ "$recovery_state" != started ]] || {
    echo 'Regtest recovery is in progress; refusing to restart the original node identity' >&2
    exit 1
  }
fi

monitoring=false
loop=false
router=false
router_external_ip_saved=''
if helm -n "$namespace" status lnd-ops >/dev/null 2>&1; then
  monitoring=$(helm -n "$namespace" get values lnd-ops -o json | python3 -c 'import json,sys; print(str(json.load(sys.stdin).get("monitoring", {}).get("enabled", False)).lower())')
  loop=$(helm -n "$namespace" get values lnd-ops -o json | python3 -c 'import json,sys; print(str(json.load(sys.stdin).get("loop", {}).get("enabled", False)).lower())')
  router=$(helm -n "$namespace" get values lnd-ops -o json | python3 -c 'import json,sys; print(str(json.load(sys.stdin).get("router", {}).get("enabled", False)).lower())')
  router_external_ip_saved=$(helm -n "$namespace" get values lnd-ops -o json | python3 -c 'import json,sys; print(json.load(sys.stdin).get("router", {}).get("externalIP", ""))')
fi
if [[ "$monitoring_requested" == true ]]; then
  if ! kubectl get namespace "$namespace" >/dev/null 2>&1; then
    echo "ACTION: deploy the wallet-free $profile profile before enabling monitoring" >&2
    exit 10
  fi
  nodes=1
  [[ "$profile" == regtest ]] && nodes=2
  for ((i=0; i<nodes; i++)); do
    pod=lnd-$i-0
    if ! kubectl -n "$namespace" exec "$pod" -- test -s "/data/.lnd/data/chain/bitcoin/$profile/readonly.macaroon" >/dev/null 2>&1; then
      echo "ACTION $pod: create/unlock wallet and provide its read-only macaroon before enabling monitoring" >&2
      exit 10
    fi
    if ! kubectl -n "$namespace" exec "$pod" -- lncli --lnddir=/data/.lnd --network="$profile" getinfo >/dev/null 2>&1; then
      echo "ACTION $pod: unlock wallet before enabling monitoring" >&2
      exit 10
    fi
  done
  monitoring=true
fi
if [[ "$loop_requested" == true ]]; then
  [[ "$monitoring" == true ]] || {
    echo 'ACTION: enable monitoring before Loop so its health metrics are collected' >&2
    exit 10
  }
  kubectl -n "$namespace" get secret lnd-loop-credentials >/dev/null 2>&1 || {
    echo 'ACTION: run ops/enable-loop --macaroon /secure/path/loop.macaroon to provide Loop credentials' >&2
    exit 10
  }
  loop=true
fi
[[ "$loop_disabled" == false ]] || loop=false
if [[ "$router_requested" == true ]]; then
  router=true
  router_external_ip_saved=$router_external_ip
fi

if ! kubectl get namespace "$namespace" >/dev/null 2>&1; then
  echo "Creating namespace $namespace"
  kubectl create namespace "$namespace"
fi
kubectl label namespace "$namespace" lnd-ops-security=protected pod-security.kubernetes.io/enforce=baseline --overwrite >/dev/null

echo "Applying $profile chart to $namespace"
helm_command=(helm upgrade --install lnd-ops "$repo_dir/charts/lnd-ops"
  --namespace "$namespace"
  --values "$repo_dir/charts/lnd-ops/values-$profile.yaml"
  --set "monitoring.enabled=$monitoring"
  --set "loop.enabled=$loop"
  --set "router.enabled=$router")
if [[ "$router" == true ]]; then
  [[ -n "$router_external_ip_saved" ]] || { echo 'Existing Router mode has no external host; rerun with --router --router-external-ip HOST' >&2; exit 1; }
  helm_command+=(--set-string "router.externalIP=$router_external_ip_saved")
fi
if [[ "$monitoring" == true ]]; then
  # Adding the sidecars restarts the Pod and LND may need a manual wallet unlock.
  # The collector source is mounted from the chart and runs on the pinned
  # multi-architecture Python image, so deployment needs no node-local import.
  :
else
  helm_command+=(--wait --timeout 15m)
fi
"${helm_command[@]}"
kubectl -n "$namespace" get pods,pvc
if [[ "$monitoring" == true ]]; then
  echo "ACTION: after the $profile rollout, unlock any locked LND wallet and run ops/verify $profile and ops/verify-monitoring"
fi
