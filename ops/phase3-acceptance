#!/usr/bin/env python3
"""Read-only acceptance gate for the Phase 3 integrated operations view."""

import json
import os
import pathlib
import platform
import subprocess
import sys
from datetime import datetime, timezone

REPO = pathlib.Path(__file__).resolve().parent.parent
STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state")) / "lnd-ops"
EVIDENCE = STATE / "evidence"


class ManualGate(Exception):
    pass


class Failure(Exception):
    pass


def detail_line(result, fallback):
    lines = (result.stderr or result.stdout).strip().splitlines()
    detail = lines[-1] if lines else fallback
    while detail.startswith(("ACTION: ", "FAIL: ")):
        detail = detail.split(": ", 1)[1]
    return detail


def run(name, arguments):
    result = subprocess.run([str(REPO / "ops" / name), *arguments], text=True, capture_output=True, timeout=600)
    if result.returncode == 10:
        raise ManualGate(detail_line(result, f"manual gate: {name}"))
    if result.returncode:
        raise Failure(detail_line(result, f"failed: {name}"))
    output = result.stdout.strip()
    if not output:
        raise Failure(f"{name} returned success without a result summary")
    return output


def write_result(payload, now):
    EVIDENCE.mkdir(parents=True, exist_ok=True, mode=0o700)
    EVIDENCE.chmod(0o700)
    path = EVIDENCE / f"phase3-acceptance-{now.strftime('%Y%m%dT%H%M%S.%fZ')}.json"
    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w") as output:
            json.dump(payload, output, indent=2, sort_keys=True)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.link(temporary, path)
        path.chmod(0o600)
    finally:
        temporary.unlink(missing_ok=True)
    return path


def main(arguments):
    if arguments:
        print("Usage: ops/phase3-acceptance", file=sys.stderr)
        return 2
    os.environ.setdefault("KUBECONFIG", str(STATE / "kubeconfig"))
    try:
        status = subprocess.run(
            ["git", "-C", str(REPO), "status", "--porcelain"], text=True, capture_output=True, check=True, timeout=30
        ).stdout
        if status:
            raise Failure("repository worktree must be clean before Phase 3 acceptance")
        phase1 = run("acceptance", ["testnet"])
        monitoring = run("verify-monitoring", ["--profile", "testnet"])
        backup = run("backup-status-encrypted", ["testnet", "lnd-0"])
        dashboards = run("verify-dashboards", [])
        commit = subprocess.run(
            ["git", "-C", str(REPO), "rev-parse", "HEAD"], text=True, capture_output=True, check=True, timeout=30
        ).stdout.strip()
        context = subprocess.run(
            ["kubectl", "config", "current-context"], text=True, capture_output=True, check=True, timeout=30
        ).stdout.strip()
        now = datetime.now(timezone.utc)
        payload = {
            "schema": "lnd-ops/phase3-acceptance/v1",
            "result": "pass",
            "checked_at": now.isoformat().replace("+00:00", "Z"),
            "host": {"system": platform.system(), "machine": platform.machine()},
            "profile": "testnet",
            "git_commit": commit,
            "kubeconfig": str(pathlib.Path(os.environ["KUBECONFIG"]).expanduser().resolve()),
            "kubernetes_context": context,
            "checks": {
                "phase1_continuity": "pass",
                "live_monitoring": "pass",
                "current_encrypted_scb": "pass",
                "six_dashboards_and_live_queries": "pass",
                "alerts_and_runbooks": "pass",
            },
            "summaries": {
                "phase1": phase1.splitlines()[0],
                "monitoring": monitoring.splitlines()[-1],
                "backup": "Encrypted SCB is current and verified",
                "dashboards": dashboards.splitlines()[-1],
            },
            "proof_commands": {
                "phase1_continuity": "ops/acceptance testnet",
                "live_monitoring": "ops/verify-monitoring --profile testnet",
                "current_encrypted_scb": "ops/backup-status-encrypted testnet lnd-0",
                "six_dashboards_and_live_queries": "ops/verify-dashboards",
                "alerts_and_runbooks": "ops/verify-dashboards",
            },
            "phase4_exclusions": ["Falco events", "certificate expiry"],
        }
        path = write_result(payload, now)
        print(f"OK Phase 3 acceptance: {payload['summaries']['dashboards']}")
        print(f"Evidence: {path}")
        return 0
    except ManualGate as exc:
        print(f"ACTION: {exc}", file=sys.stderr)
        return 10
    except (Failure, OSError, subprocess.SubprocessError, subprocess.TimeoutExpired, IndexError) as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
