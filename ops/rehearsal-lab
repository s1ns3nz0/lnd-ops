    kubectl("-n", "lndops-monitoring", "rollout", "status", f"statefulset/alertmanager-{AM_SVC}", "--timeout=5m")
    print("ok: monitoring and the L402 probe exporter installed, L402 rules loaded in Prometheus")


# --- step 6: synthetic Aperture + dummy workloads -----------------------------------------------------------
def deployment(name, command, extra_pod=None, extra_container=None, replicas=1):
    labels = {"app.kubernetes.io/name": name}
    container = {"name": "main", "image": PY_IMAGE, "command": command,
                 "resources": {"requests": {"cpu": "5m", "memory": "16Mi"}, "limits": {"memory": "128Mi"}},
                 "readinessProbe": {"exec": {"command": ["true"]}, "periodSeconds": 5}, **(extra_container or {})}
    return {"apiVersion": "apps/v1", "kind": "Deployment", "metadata": {"name": name, "namespace": APP_NS, "labels": labels},
            "spec": {"replicas": replicas, **({} if name == APERTURE else {"strategy": {"type": "Recreate"}}),
                     "selector": {"matchLabels": labels},
                     "template": {"metadata": {"labels": labels}, "spec": {"containers": [container], **(extra_pod or {})}}}}


def healthy_command(name):
    if name not in HEALTHY_SERVERS:
        return HEALTHY_CMD
    port, path, body, tls = HEALTHY_SERVERS[name]
    return [*DUMMY_HTTP, str(port), path, body, *(["/tls/tls.crt", "/tls/tls.key"] if tls else [])]


def dummy_deployment(name):
    if name not in HEALTHY_SERVERS:
        return deployment(name, HEALTHY_CMD)
    port, _, _, tls = HEALTHY_SERVERS[name]
    volumes = [{"name": "app", "configMap": {"name": "dummy-http"}}]
    mounts = [{"name": "app", "mountPath": "/app", "readOnly": True}]
    if tls:
        volumes.append({"name": "tls", "secret": {"secretName": "lnd-merchant-tls"}})
        mounts.append({"name": "tls", "mountPath": "/tls", "readOnly": True})
    return deployment(name, healthy_command(name), extra_pod={"volumes": volumes}, extra_container={
        "ports": [{"name": "probe", "containerPort": port}], "volumeMounts": mounts,
        "readinessProbe": {"tcpSocket": {"port": port}, "periodSeconds": 5}})


def service(name, ports):
    return {"apiVersion": "v1", "kind": "Service",
            "metadata": {"name": name, "namespace": APP_NS, "labels": {"app.kubernetes.io/name": name}},
            "spec": {"selector": {"app.kubernetes.io/name": name},
                     "ports": [{"name": n, "port": p, "targetPort": p} for n, p in ports]}}


def workload_objects():
    objects = [dummy_deployment(name) for name in DUMMIES]
    aperture = deployment(
        APERTURE, ["python3", "/app/aperture_exporter.py"],
        extra_pod={"volumes": [{"name": "app", "configMap": {"name": "aperture-exporter"}},
                               {"name": "state", "emptyDir": {}}]},
        extra_container={"ports": [{"name": "metrics", "containerPort": 9000}, {"name": "proxy", "containerPort": 8081}],
                         "readinessProbe": {"httpGet": {"path": "/metrics", "port": 9000}, "periodSeconds": 5},
                         "volumeMounts": [{"name": "app", "mountPath": "/app", "readOnly": True},
                                          {"name": "state", "mountPath": "/state"}]})
    return objects + [aperture, service(APERTURE, [("metrics", 9000), ("proxy", 8081)]),
                      service("payment-aperture-services", [("health", 8090)]), service("lnd-merchant", [("rest", 8080)])]


def ensure_merchant_tls():
    """Self-signed cert for the dummy merchant LND, generated once in the lab state dir (the probe skips verification)."""
    key, crt = STATE / "lnd-merchant.key", STATE / "lnd-merchant.crt"
    if not (key.is_file() and crt.is_file()):
        run(["openssl", "req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1", "-nodes",
             "-keyout", key, "-out", crt, "-subj", "/CN=lnd-merchant", "-days", "30",
             "-addext", f"subjectAltName=DNS:lnd-merchant,DNS:lnd-merchant.{APP_NS}.svc"], timeout=60)
        os.chmod(key, 0o600)
    kubectl("apply", "-f", "-", input_text=kubectl(
        "-n", APP_NS, "create", "secret", "tls", "lnd-merchant-tls", f"--cert={crt}", f"--key={key}",
        "--dry-run=client", "-o", "yaml"))


def step_workloads():
    apply_configmap(APP_NS, "aperture-exporter", REPO / "lab/rehearsal/aperture_exporter.py")
    apply_configmap(APP_NS, "dummy-http", REPO / "lab/rehearsal/dummy_http.py")
    ensure_merchant_tls()
    for obj in workload_objects():
        apply(obj)
    for name in (*DUMMIES, APERTURE):
        kubectl("-n", APP_NS, "rollout", "status", f"deployment/{name}", "--timeout=5m", timeout=330)
    endpoints = kubectl_json("-n", APP_NS, "get", "endpoints", APERTURE)
    if not endpoints.get("subsets"):
        raise LabError("l402-aperture Service has no ready endpoints")
    print(f"ok: {len(DUMMIES)} dummy workloads and the synthetic {APERTURE} are Ready")


