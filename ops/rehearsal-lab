def step_kagent(model, address):
    vendor = REPO / "charts/vendor"
    helm("upgrade", "--install", "kagent-crds", vendor / f"kagent-crds-{KAGENT_VERSION}.tgz",
         "--namespace", "lndops-kagent", "--wait", "--timeout", "10m")
    kubectl("wait", "--for=condition=Established", "crd/agents.kagent.dev", "crd/modelconfigs.kagent.dev",
            "crd/remotemcpservers.kagent.dev", "--timeout=2m")
    helm("upgrade", "--install", "kagent", vendor / f"kagent-{KAGENT_VERSION}.tgz", "--namespace", "lndops-kagent",
         "--values", REPO / "charts/kagent-values.yaml",
         "--set-string", f"providers.ollama.model={model}",
         "--set-string", f"providers.ollama.config.host=http://{address}:{OLLAMA_PORT}", "--wait", "--timeout", "15m")
    for name in ("kagent-controller", "kagent-ui"):
        kubectl("-n", "lndops-kagent", "rollout", "status", f"deployment/{name}", "--timeout=5m", timeout=330)
    print("ok: kagent controller and UI rolled out")


def shipped_runbooks():
    """The runbooks ops/deploy-agent ships, read from that script so the lists cannot drift."""
    names = re.findall(r'REPO / "docs/runbooks/([\w-]+\.md)"', (REPO / "ops/deploy-agent").read_text())
    if not names:
        raise LabError("could not read the runbook list from ops/deploy-agent")
    return [REPO / "docs/runbooks" / n for n in names]


def kube_api_endpoint():
    """Same computation as ops/deploy-agent."""
    items = kubectl_json("-n", "default", "get", "endpointslice", "-l", "kubernetes.io/service-name=kubernetes")["items"]
    addresses = sorted({a for i in items for e in i.get("endpoints", []) for a in e.get("addresses", [])
                        if ipaddress.ip_address(a).version == 4})
    ports = sorted({int(p["port"]) for i in items for p in i.get("ports", []) if p.get("port")})
    if len(addresses) != 1 or len(ports) != 1:
        raise LabError("expected exactly one IPv4 Kubernetes API endpoint")
    return addresses[0], ports[0]


