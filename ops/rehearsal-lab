def step_monitoring():
    chart = REPO / "charts/vendor" / monitoring_chart()
    password = STATE / "grafana-admin-password"
    if not password.is_file():
        write_private(password, secrets.token_urlsafe(32))
    write_private(STATE / "grafana-admin-user", "admin")
    if kubectl("-n", "lndops-monitoring", "get", "secret", "lnd-ops-grafana-admin", check=False).returncode:
        kubectl("-n", "lndops-monitoring", "create", "secret", "generic", "lnd-ops-grafana-admin",
                f"--from-file=admin-user={STATE / 'grafana-admin-user'}", f"--from-file=admin-password={password}")
    apply_configmap("lndops-monitoring", "lnd-ops-dashboards", REPO / "charts/dashboards")
    kubectl("-n", "lndops-monitoring", "label", "configmap", "lnd-ops-dashboards", "grafana_dashboard=1", "--overwrite")
    override = STATE / "monitoring-lab-values.yaml"
    write_private(override, json.dumps(monitoring_override(), indent=2) + "\n")
    helm("upgrade", "--install", "lnd-ops-monitoring", chart, "--namespace", "lndops-monitoring",
         "--values", REPO / "charts/monitoring-values.yaml", "--values", override, "--wait", "--timeout", "15m")
    kubectl("apply", "-f", REPO / "charts/monitoring-rules.yaml")

    def rules_loaded():
        with port_forward("lndops-monitoring", f"service/{PROM_SVC}", 9090) as port:
            groups = http_json(f"http://127.0.0.1:{port}/api/v1/rules")["data"]["groups"]
        return any(g["name"] == "opencti-l402" for g in groups)
    wait_for("Prometheus to load the opencti-l402 rule group", rules_loaded, 300, 5)
    kubectl("-n", "lndops-monitoring", "rollout", "status", f"statefulset/alertmanager-{AM_SVC}", "--timeout=5m")
    print("ok: monitoring installed, opencti-l402 rules loaded in Prometheus")


# --- step 6: synthetic Aperture + dummy workloads -----------------------------------------------------------
def deployment(name, command, extra_pod=None, extra_container=None, replicas=1):
    labels = {"app.kubernetes.io/name": name}
    container = {"name": "main", "image": PY_IMAGE, "command": command,
                 "resources": {"requests": {"cpu": "5m", "memory": "16Mi"}, "limits": {"memory": "128Mi"}},
                 "readinessProbe": {"exec": {"command": ["true"]}, "periodSeconds": 5}, **(extra_container or {})}
    return {"apiVersion": "apps/v1", "kind": "Deployment", "metadata": {"name": name, "namespace": APP_NS, "labels": labels},
            "spec": {"replicas": replicas, "selector": {"matchLabels": labels},
                     "template": {"metadata": {"labels": labels}, "spec": {"containers": [container], **(extra_pod or {})}}}}


def workload_objects():
    objects = [deployment(name, HEALTHY_CMD) for name in DUMMIES]
    aperture = deployment(
        APERTURE, ["python3", "/app/aperture_exporter.py"],
        extra_pod={"volumes": [{"name": "app", "configMap": {"name": "aperture-exporter"}},
                               {"name": "state", "emptyDir": {}}]},
        extra_container={"ports": [{"name": "metrics", "containerPort": 9000}],
                         "readinessProbe": {"httpGet": {"path": "/metrics", "port": 9000}, "periodSeconds": 5},
                         "volumeMounts": [{"name": "app", "mountPath": "/app", "readOnly": True},
                                          {"name": "state", "mountPath": "/state"}]})
    service = {"apiVersion": "v1", "kind": "Service",
               "metadata": {"name": APERTURE, "namespace": APP_NS, "labels": {"app.kubernetes.io/name": APERTURE}},
               "spec": {"selector": {"app.kubernetes.io/name": APERTURE},
                        "ports": [{"name": "metrics", "port": 9000, "targetPort": "metrics"}]}}
    return objects + [aperture, service]


def step_workloads():
    apply_configmap(APP_NS, "aperture-exporter", REPO / "lab/rehearsal/aperture_exporter.py")
    for obj in workload_objects():
        apply(obj)
    for name in (*DUMMIES, APERTURE):
        kubectl("-n", APP_NS, "rollout", "status", f"deployment/{name}", "--timeout=5m", timeout=330)
    endpoints = kubectl_json("-n", APP_NS, "get", "endpoints", APERTURE)
    if not endpoints.get("subsets"):
        raise LabError("l402-aperture Service has no ready endpoints")
    print(f"ok: {len(DUMMIES)} dummy workloads and the synthetic {APERTURE} are Ready")


