RATE_WRITER = ("import os,sys;p='/state/rates.json';t=p+'.tmp';"
               "open(t,'w').write(sys.argv[1]);os.replace(t,p)")


def set_rates(rates):
    payload = json.dumps(rates or {})
    kubectl("-n", APP_NS, "exec", f"deploy/{APERTURE}", "--", "python3", "-c", RATE_WRITER, payload)


def command_patch(command):
    return json.dumps({"spec": {"template": {"spec": {"containers": [{"name": "main", "command": command}]}}}})


def restore_workloads():
    for name in DUMMIES:
        kubectl("-n", APP_NS, "patch", f"deployment/{name}", "-p", command_patch(HEALTHY_CMD))
    kubectl("-n", APP_NS, "scale", f"deployment/{APERTURE}", "--replicas=1")


def apply_scenario(name):
    scenario = SCENARIOS[name]
    restore_workloads()
    for broken in scenario["broken"]:
        kubectl("-n", APP_NS, "patch", f"deployment/{broken}", "-p", command_patch(BROKEN_CMD))
    if scenario["replicas"] == 0:
        kubectl("-n", APP_NS, "scale", f"deployment/{APERTURE}", "--replicas=0")
    else:
        kubectl("-n", APP_NS, "rollout", "status", f"deployment/{APERTURE}", "--timeout=3m", timeout=210)
        set_rates(scenario["rates"])
    for dummy in DUMMIES:
        if dummy not in scenario["broken"]:
            kubectl("-n", APP_NS, "rollout", "status", f"deployment/{dummy}", "--timeout=3m", timeout=210)
    write_private(STATE / "scenario", name + "\n")


def describe(name):
    s = SCENARIOS[name]
    print(f"scenario {name}: {s['summary']}")
    print(f"  expected alert : {s['alert'] or 'none'}")
    print(f"  timing         : {s['timing']}")
    print(f"  compare with   : {PLAYBOOK}  ->  {s['section']}")
    print("  next           : ops/rehearsal-lab status | ui | ask paid-scan-diagnosis \"Is the L402 payment gate healthy?\"")


def step_baseline():
    apply_scenario("healthy")

    def scraped():
        with port_forward("lndops-monitoring", f"service/{PROM_SVC}", 9090) as port:
            url = f"http://127.0.0.1:{port}/api/v1/query?query=" + urllib.parse.quote('up{job="aperture"}==1')
            return bool(http_json(url)["data"]["result"])
    wait_for("Prometheus to scrape the aperture target", scraped, 300, 5)
    print("ok: baseline traffic seeded and up{job=\"aperture\"} == 1")


