class LabError(Exception):
    pass


# --- process helpers -----------------------------------------------------------------------------------------
def env():
    return {**os.environ, "KUBECONFIG": str(KUBECONFIG)}  # belt and braces next to the explicit flags


def run(args, input_text=None, timeout=1200, check=True, extra_env=None):
    try:
        result = subprocess.run([str(a) for a in args], input=input_text, text=True, capture_output=True,
                                timeout=timeout, env={**env(), **(extra_env or {})})
    except (OSError, subprocess.SubprocessError) as exc:
        raise LabError(f"{args[0]}: {exc}") from None
    if check and result.returncode:
        lines = (result.stderr or result.stdout).strip().splitlines()
        raise LabError(f"{args[0]} failed: {lines[-1] if lines else 'no output'}")
    return result.stdout if check else result


def kubectl(*args, **kw):
    return run(["kubectl", "--kubeconfig", KUBECONFIG, *args], **kw)


def helm(*args, **kw):
    return run(["helm", "--kubeconfig", KUBECONFIG, *args], **kw)


def kubectl_json(*args):
    return json.loads(kubectl(*args, "-o", "json"))


def apply(obj):
    kubectl("apply", "-f", "-", input_text=json.dumps(obj))


def apply_configmap(namespace, name, *sources):
    """kubectl create configmap --dry-run | apply, like ops/deploy-agent. Sources: files or key=literal strings."""
    args = ["-n", namespace, "create", "configmap", name, "--dry-run=client", "-o", "yaml"]
    for source in sources:
        args.append(f"--from-literal={source[0]}={source[1]}" if isinstance(source, tuple) else f"--from-file={source}")
    kubectl("apply", "-f", "-", input_text=kubectl(*args))


def write_private(path, text):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, "w") as stream:
        stream.write(text)
    os.chmod(path, 0o600)


def ensure_state():
    if STATE.is_symlink():
        raise LabError(f"{STATE} must not be a symlink")
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(STATE, 0o700)


def http_json(url, timeout=10):
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers={"Accept": "application/json"}), timeout=timeout) as r:
            return json.load(r)
    except (OSError, ValueError) as exc:
        raise LabError(f"GET {url} failed: {exc}") from None


def free_port():
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]


@contextlib.contextmanager
def port_forward(namespace, target, remote, local=None):
    local = local or free_port()
    process = subprocess.Popen(
        ["kubectl", "--kubeconfig", str(KUBECONFIG), "-n", namespace, "port-forward", "--address", "127.0.0.1",
         target, f"{local}:{remote}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env())
    try:
        wait_port(local, process, f"{namespace}/{target}")
        yield local
    finally:
        stop(process)


def wait_port(port, process, what):
    for _ in range(150):
        if process.poll() is not None:
            raise LabError(f"port-forward to {what} exited early")
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=.2):
                return
        except OSError:
            time.sleep(.1)
    raise LabError(f"port-forward to {what} did not become ready")


def stop(process):
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()


def wait_for(description, predicate, timeout=300, interval=3):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        with contextlib.suppress(LabError, KeyError, IndexError, ValueError):
            if predicate():
                return
        time.sleep(interval)
    raise LabError(f"timed out waiting for {description}")


def wait_deployment(namespace, name, timeout=300):
    wait_for(f"deployment {namespace}/{name} to exist", lambda: kubectl("-n", namespace, "get", "deployment", name), 300)
    kubectl("-n", namespace, "rollout", "status", f"deployment/{name}", f"--timeout={timeout}s", timeout=timeout + 30)


# --- guard ---------------------------------------------------------------------------------------------------
def current_context():
    return run(["kubectl", "--kubeconfig", KUBECONFIG, "config", "current-context"], timeout=30).strip()


def check_context(context):
    if context != CONTEXT:
        raise LabError(f"refusing to run: kubeconfig context is {context!r}, expected {CONTEXT!r}")


def guard():
    if not KUBECONFIG.is_file():
        raise LabError(f"lab kubeconfig missing ({KUBECONFIG}); run `ops/rehearsal-lab up` first")
    check_context(current_context())


# --- step 1: preflight ---------------------------------------------------------------------------------------
def sha256(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def expected_checksums():
    """SHA256SUMS covers kagent and kagent-crds; the monitoring chart's digest lives in ops/deploy-monitoring."""
    vendor = REPO / "charts/vendor"
    sums = {name: digest for digest, name in
            (line.split() for line in (vendor / "SHA256SUMS").read_text().splitlines() if line.strip())}
    charts = {f"kagent-{KAGENT_VERSION}.tgz": sums.get(f"kagent-{KAGENT_VERSION}.tgz"),
              f"kagent-crds-{KAGENT_VERSION}.tgz": sums.get(f"kagent-crds-{KAGENT_VERSION}.tgz")}
    monitoring = re.search(r"^chart=.*/(kube-prometheus-stack-[\d.]+\.tgz)$", (REPO / "ops/deploy-monitoring").read_text(), re.M)
    digest = re.search(r"^expected=([0-9a-f]{64})$", (REPO / "ops/deploy-monitoring").read_text(), re.M)
    if not monitoring or not digest:
        raise LabError("could not read the kube-prometheus-stack checksum from ops/deploy-monitoring")
    charts[monitoring.group(1)] = digest.group(1)
    if not all(charts.values()):
        raise LabError("charts/vendor/SHA256SUMS lacks a kagent or kagent-crds checksum")
    return charts


def monitoring_chart():
    return next(name for name in expected_checksums() if name.startswith("kube-prometheus-stack"))


def step_preflight(model):
    for tool in ("docker", "kind", "helm", "kubectl", "openssl"):
        if not shutil.which(tool):
            raise LabError(f"{tool} is not installed")
    run(["docker", "info"], timeout=60)
    version = run(["kind", "version"], timeout=30)
    if not re.match(rf"kind {re.escape(KIND_VERSION)}\b", version):
        raise LabError(f"kind {KIND_VERSION} required: the pinned node image digest belongs to that release (found: {version.strip()})")
    base = f"http://127.0.0.1:{OLLAMA_PORT}"
    if "version" not in http_json(f"{base}/api/version"):
        raise LabError("Ollama /api/version did not return a version")
    names = {m.get("name") for m in http_json(f"{base}/api/tags").get("models", [])}
    if model not in names and f"{model}:latest" not in names:
        raise LabError(f"Ollama does not have model {model!r} (has: {', '.join(sorted(n for n in names if n)) or 'none'})")
    for name, digest in expected_checksums().items():
        if sha256(REPO / "charts/vendor" / name) != digest:
            raise LabError(f"vendor chart checksum mismatch: {name}")
    print(f"ok: tools, kind {KIND_VERSION}, Ollama model {model}, vendor chart checksums")


# --- step 2/3: cluster and host address ---------------------------------------------------------------------
def step_cluster():
    if CLUSTER in run(["kind", "get", "clusters"], timeout=60).split():
        run(["kind", "export", "kubeconfig", "--name", CLUSTER, "--kubeconfig", KUBECONFIG], timeout=60)
        print(f"cluster {CLUSTER} already exists; reusing it")
    else:
        run(["kind", "create", "cluster", "--name", CLUSTER, "--image", NODE_IMAGE, "--kubeconfig", KUBECONFIG,
             "--wait", "5m"], timeout=900)
    os.chmod(KUBECONFIG, 0o600)
    check_context(current_context())
    kubectl("wait", "--for=condition=Ready", "node", "--all", "--timeout=2m")
    print(f"ok: {CONTEXT} node Ready, image {NODE_IMAGE}")


def parse_host_address(getent_output):
    for line in getent_output.splitlines():
        fields = line.split()
        if fields:
            with contextlib.suppress(ValueError):
                address = ipaddress.ip_address(fields[0])
                if address.version == 4:
                    return str(address)
    raise LabError("host.docker.internal did not resolve to an IPv4 address inside the kind node")


def step_host_address():
    out = run(["docker", "exec", NODE, "getent", "ahostsv4", "host.docker.internal"], timeout=60, check=False)
    if out.returncode:
        raise LabError("host.docker.internal does not resolve inside the kind node (Docker Desktop required)")
    address = parse_host_address(out.stdout)
    url = f"http://{address}:{OLLAMA_PORT}/api/version"
    probe = ("import sys,urllib.request;print(urllib.request.urlopen(sys.argv[1],timeout=10).read().decode())")
    result = kubectl("run", "ollama-probe", "--rm", "-i", "-q", "--restart=Never", "--image", PY_IMAGE,
                     "--pod-running-timeout=5m", "--command", "--", "python3", "-c", probe, url, timeout=420, check=False)
    if result.returncode or '"version"' not in result.stdout:
        raise LabError(f"a pod in the cluster cannot reach Ollama at {url}. Ollama must listen on more than "
                       "127.0.0.1 (start it with OLLAMA_HOST=0.0.0.0:11434) and Docker Desktop must allow host access")
    print(f"ok: pod reached Ollama at {url}")
    return address


