def fault_active(name):
    """True once the Deployment has no ready replica and a pod is crashing (restart, CrashLoopBackOff or Error)."""
    if kubectl_json("-n", APP_NS, "get", "deployment", name)["status"].get("readyReplicas"):
        return False
    pods = kubectl_json("-n", APP_NS, "get", "pods", "-l", f"app.kubernetes.io/name={name}")["items"]
    return any(c.get("restartCount", 0) >= 1 or c.get("state", {}).get("waiting", {}).get("reason") in ("CrashLoopBackOff", "Error")
               for pod in pods for c in pod["status"].get("containerStatuses", []))


def break_workload(name):
    kubectl("-n", APP_NS, "patch", f"deployment/{name}", "-p", command_patch(BROKEN_CMD))
    wait_for(f"{name} to be down (ready 0, crashing)", lambda: fault_active(name), 120, 3)
    print(f"fault active: {name} ready 0/1")


# --- funnel verdict, and the 15-minute window that scenarios bleed through ----------------------------------
FUNNEL_CLIENT = ("import sys,urllib.request;r=urllib.request.Request('http://127.0.0.1:8080/mcp',data=sys.argv[1].encode(),"
                 "headers={'Content-Type':'application/json','Accept':'application/json'},method='POST');"
                 "print(urllib.request.urlopen(r,timeout=30).read().decode())")
FUNNEL_CALL = json.dumps({"jsonrpc": "2.0", "id": 1, "method": "tools/call",
                          "params": {"name": "diagnose_l402_funnel", "arguments": {}}})
WINDOW_SECONDS = 15 * 60 + 30
LEFT_FILE = "left-fault"


def funnel_state():
    """(verdict, challenges_issued) from the paid-scan MCP tool, via the diagnostics pod like exercise-phase7-agent."""
    out = kubectl("-n", "lndops-agent", "exec", "deploy/paid-scan-diagnostics", "-c", "gateway", "--",
                  "python3", "-c", FUNNEL_CLIENT, FUNNEL_CALL)
    reply = json.loads(out)
    if "error" in reply:
        raise LabError(f"diagnose_l402_funnel: {reply['error'].get('message')}")
    result = json.loads(reply["result"]["content"][0]["text"])
    return result.get("verdict"), result.get("challenges_issued") or 0


def wait_funnel_healthy(timeout=360, interval=15):
    last = []

    def healthy():
        last[:] = [funnel_state()]
        return last[0][0] == "healthy" and last[0][1] >= 1
    try:
        wait_for("the funnel verdict to be healthy", healthy, timeout, interval)
    except LabError as exc:
        raise LabError(f"{exc} (last seen verdict/challenges_issued: {last[0] if last else 'no answer'})") from None
    print(f"ok: funnel verdict healthy (challenges_issued={last[0][1]})", flush=True)


def read_scenario():
    path = STATE / "scenario"
    return path.read_text().strip() if path.is_file() else None


def window_remaining():
    try:
        return float((STATE / LEFT_FILE).read_text()) + WINDOW_SECONDS - time.time()
    except (OSError, ValueError):
        return 0.0


def wait_window():
    remaining = window_remaining()
    while remaining > 0:
        minutes, seconds = divmod(int(remaining + .999), 60)
        print(f"previous scenario still inside the 15-minute window: waiting {minutes} min {seconds} s (use --force to skip)",
              flush=True)
        time.sleep(min(60, remaining))
        remaining = window_remaining()


def settle_previous():
    """Before a fault: drain the old scenario's metrics from the alert windows and confirm the funnel is clean."""
    if not (STATE / LEFT_FILE).is_file():
        return
    kubectl("-n", APP_NS, "rollout", "status", f"deployment/{APERTURE}", "--timeout=3m", timeout=210)
    set_rates(HEALTHY_RATES)  # stop feeding the old fault while the window drains
    wait_window()
    wait_funnel_healthy(timeout=180)


def apply_scenario(name, force=False):
    scenario = SCENARIOS[name]
    previous = read_scenario()
    restore_workloads()
    if previous not in (None, "healthy"):
        write_private(STATE / LEFT_FILE, f"{time.time()}\n")
    if name != "healthy" and not force:
        settle_previous()
    for broken in scenario["broken"]:
        break_workload(broken)
    if scenario["replicas"] == 0:
        kubectl("-n", APP_NS, "scale", f"deployment/{APERTURE}", "--replicas=0")
    else:
        kubectl("-n", APP_NS, "rollout", "status", f"deployment/{APERTURE}", "--timeout=3m", timeout=210)
        set_rates(scenario["rates"])
    write_private(STATE / "scenario", name + "\n")
    return previous


def describe(name):
