def parts_of(event):
    return [p for p in event.get("parts", []) if isinstance(p, dict)] if isinstance(event, dict) else []


def parse_invocation(invocation):
    """(final answer text, [(tool name, arguments)]) from a kagent invocation's history and artifacts."""
    def text_of(part):
        text = part.get("text")
        return text if isinstance(text, str) else ""
    chunks = [text_of(p) for a in invocation.get("artifacts") or [] for p in parts_of(a)]
    answer = "\n".join(c for c in chunks if c)
    if not answer:
        for event in reversed(invocation.get("history", [])):
            if isinstance(event, dict) and event.get("role") == "agent":  # never echo the user's own message
                answer = "\n".join(t for t in map(text_of, parts_of(event)) if t)
                if answer:
                    break
    calls = []
    for event in invocation.get("history", []):
        for part in parts_of(event):
            data = part.get("data")
            if isinstance(data, dict) and isinstance(data.get("name"), str) and "response" not in data:
                calls.append((data["name"], data.get("args", data.get("arguments"))))
    return answer, calls


def task_state(invocation):
    status = invocation.get("status")
    state = status.get("state") if isinstance(status, dict) else status
    return state if isinstance(state, str) and state else "unknown"


def agent_questions(calls):
    """Question texts from kagent's ask_user / adk_request_confirmation tool calls, in order, deduplicated."""
    found = []
    for name, arguments in calls:
        if name not in ("ask_user", "adk_request_confirmation") or not isinstance(arguments, dict):
            continue
        items = arguments.get("questions")
        texts = [q.get("question") for q in items if isinstance(q, dict)] if isinstance(items, list) else []
        confirmation = arguments.get("toolConfirmation")
        texts.append(confirmation.get("hint") if isinstance(confirmation, dict) else None)
        found += [t for t in texts if isinstance(t, str) and t.strip() and t not in found]
    return found


def cmd_ask(args):
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    raw = STATE / "evidence" / f"ask-{args.agent}-{stamp}.json"
    with port_forward("lndops-kagent", "service/kagent-controller", 8083) as port:
        # ops/kagent-cli caches its binary under XDG_STATE_HOME; point that at the lab state dir.
        result = run([REPO / "ops/kagent-cli", "--kagent-url", f"http://127.0.0.1:{port}", "--namespace", "lndops-kagent",
                      "invoke", "--agent", args.agent, "--task", args.question, "--timeout", "8m"],
                     timeout=600, extra_env={"XDG_STATE_HOME": str(STATE / "xdg")})
    write_private(raw, result)
    try:
        invocation = json.loads(result)
    except ValueError:
        raise LabError(f"kagent-cli did not return JSON; raw output saved to {raw}") from None
    answer, calls = parse_invocation(invocation)
    state = task_state(invocation)
    print(f"task state: {state}")
    print("== tool calls")
    for name, arguments in calls:
        print(f"  {name} {json.dumps(arguments, sort_keys=True)}")
    if not calls:
        print("  (none)")
    if state == "input-required":
        for text in agent_questions(calls) or ["(question text not found in the tool calls)"]:
            print(f"agent asked: {text}")
        print("continue in the kagent UI (ops/rehearsal-lab ui) or re-ask with the missing detail")
        print(f"raw JSON: {raw}")
        return 2  # distinct from failure (1)
    print("== final answer")
    print(answer or f"no agent answer (task {state})")
    print(f"\nraw JSON: {raw}")
    if state != "completed":
        raise LabError(f"task {state}, not completed")


