                    ("revision", head))
    apply_configmap(ns, "paid-scan-eval-scenarios", *sorted((REPO / "tests/eval/scenarios").glob("*.json")))
    apply_configmap(ns, "runbook-action-state", ("lastRestartEpoch", "0"))
    # Dummy credentials: order diagnosis will return unknown in the lab, by design.
    key, ca = STATE / "dummy-ca.key", STATE / "dummy-ca.crt"
    run(["openssl", "req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1", "-nodes",
         "-keyout", key, "-out", ca, "-subj", "/CN=rehearsal-dummy-ca", "-days", "2"], timeout=60)
    os.chmod(key, 0o600)
    kubectl("apply", "-f", "-", input_text=kubectl(
        "-n", ns, "create", "secret", "generic", "paid-scan-diagnostics-client", "--from-literal=token=rehearsal-dummy",
        f"--from-file=ca.crt={ca}", "--dry-run=client", "-o", "yaml"))
    api_address, api_port = kube_api_endpoint()
