def cmd_ui(args):
    ui_port = kubectl_json("-n", "lndops-kagent", "get", "service", "kagent-ui")["spec"]["ports"][0]["port"]
    targets = [("lndops-kagent", "service/kagent-ui", ui_port, 18080, "kagent UI"),
               ("lndops-monitoring", f"service/{AM_SVC}", 9093, 9093, "Alertmanager"),
               ("lndops-monitoring", f"service/{PROM_SVC}", 9090, 9090, "Prometheus")]
    processes = []
    try:
        for namespace, target, remote, local, label in targets:
            process = subprocess.Popen(
                ["kubectl", "--kubeconfig", str(KUBECONFIG), "-n", namespace, "port-forward", "--address", "127.0.0.1",
                 target, f"{local}:{remote}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env())
            processes.append(process)
            wait_port(local, process, label)
            print(f"{label}: http://127.0.0.1:{local}")
        print("Ctrl-C to stop")
        while all(p.poll() is None for p in processes):
            time.sleep(1)
        raise LabError("a port-forward exited")
    except KeyboardInterrupt:
        print()
    finally:
        for process in processes:
            stop(process)


def parts_of(event):
    return [p for p in event.get("parts", []) if isinstance(p, dict)] if isinstance(event, dict) else []


def parse_invocation(invocation):
    """(final answer text, [(tool name, arguments)]) from a kagent invocation's history and artifacts."""
    def text_of(part):
        text = part.get("text")
        return text if isinstance(text, str) else ""
    chunks = [text_of(p) for a in invocation.get("artifacts") or [] for p in parts_of(a)]
    answer = "\n".join(c for c in chunks if c)
    if not answer:
        for event in reversed(invocation.get("history", [])):
            answer = "\n".join(t for t in map(text_of, parts_of(event)) if t)
            if answer:
                break
    calls = []
    for event in invocation.get("history", []):
        for part in parts_of(event):
            data = part.get("data")
            if isinstance(data, dict) and isinstance(data.get("name"), str) and "response" not in data:
                calls.append((data["name"], data.get("args", data.get("arguments"))))
    return answer, calls


def cmd_ask(args):
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    raw = STATE / "evidence" / f"ask-{args.agent}-{stamp}.json"
    with port_forward("lndops-kagent", "service/kagent-controller", 8083) as port:
        # ops/kagent-cli caches its binary under XDG_STATE_HOME; point that at the lab state dir.
        result = run([REPO / "ops/kagent-cli", "--kagent-url", f"http://127.0.0.1:{port}", "--namespace", "lndops-kagent",
                      "invoke", "--agent", args.agent, "--task", args.question, "--timeout", "8m"],
                     timeout=600, extra_env={"XDG_STATE_HOME": str(STATE / "xdg")})
    write_private(raw, result)
    try:
        invocation = json.loads(result)
    except ValueError:
        raise LabError(f"kagent-cli did not return JSON; raw output saved to {raw}") from None
    answer, calls = parse_invocation(invocation)
    print("== tool calls")
    for name, arguments in calls:
        print(f"  {name} {json.dumps(arguments, sort_keys=True)}")
    if not calls:
        print("  (none)")
    print("== final answer")
    print(answer or "(no answer text)")
    print(f"\nraw JSON: {raw}")


def cmd_down(args):
    ensure_state()
    if KUBECONFIG.is_file() or CLUSTER in run(["kind", "get", "clusters"], timeout=60).split():
        run(["kind", "delete", "cluster", "--name", CLUSTER, "--kubeconfig", KUBECONFIG], timeout=300)
    KUBECONFIG.unlink(missing_ok=True)
    (STATE / "scenario").unlink(missing_ok=True)
    if args.purge:
        shutil.rmtree(STATE)
        print(f"purged {STATE}")
    else:
        print(f"cluster deleted; evidence and secrets kept in {STATE} (use --purge to remove)")


COMMANDS = {"up": cmd_up, "status": cmd_status, "inject": cmd_inject, "reset": cmd_reset, "ui": cmd_ui,
            "ask": cmd_ask, "down": cmd_down}


def model_name(value):
    if not value.strip() or any(c.isspace() for c in value):
        raise argparse.ArgumentTypeError("model must be a non-empty Ollama model name without whitespace")
    return value


def question(value):
    if not value.strip():
        raise argparse.ArgumentTypeError("question must not be empty")
    return value


def parse_args(argv):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("up", help="create the lab").add_argument("--model", type=model_name, default="gpt-oss:20b")
    sub.add_parser("status", help="nodes, unready pods, scenario, firing alerts")
    sub.add_parser("inject", help="apply a fault scenario").add_argument("scenario", choices=sorted(SCENARIOS))
    sub.add_parser("reset", help="same as inject healthy")
    sub.add_parser("ui", help="port-forward kagent UI, Alertmanager, Prometheus")
    ask = sub.add_parser("ask", help="invoke an agent")
    ask.add_argument("agent", choices=AGENTS)
    ask.add_argument("question", type=question)
    sub.add_parser("down", help="delete the lab").add_argument("--purge", action="store_true")
    return parser.parse_args(argv)


def main(argv):
    args = parse_args(argv)
    os.umask(0o077)
    try:
        if args.command in GUARDED:
            guard()
        COMMANDS[args.command](args)
        return 0
    except (LabError, OSError, ValueError, KeyError, subprocess.SubprocessError) as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
