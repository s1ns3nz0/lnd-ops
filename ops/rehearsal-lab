         "--namespace", "lndops-kagent", "--wait", "--timeout", "10m")
    kubectl("wait", "--for=condition=Established", "crd/agents.kagent.dev", "crd/modelconfigs.kagent.dev",
            "crd/remotemcpservers.kagent.dev", "--timeout=2m")
    helm("upgrade", "--install", "kagent", vendor / f"kagent-{KAGENT_VERSION}.tgz", "--namespace", "lndops-kagent",
         "--values", REPO / "charts/kagent-values.yaml",
