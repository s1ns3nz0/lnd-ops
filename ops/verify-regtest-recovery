#!/usr/bin/env python3
"""Read-only proof that an isolated regtest seed+SCB recovery has settled."""

import hashlib
import json
import os
import pathlib
import subprocess
import sys
from datetime import datetime, timezone


REPO = pathlib.Path(__file__).resolve().parent.parent
STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state")) / "lnd-ops"
EVIDENCE = STATE / "evidence"

os.environ.setdefault(
    "KUBECONFIG",
    str(pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state")) / "lnd-ops/kubeconfig"),
)


def kubectl_json(*args):
    return json.loads(subprocess.check_output(["kubectl", *args], text=True, stderr=subprocess.DEVNULL))


def lncli(namespace, pod, *args):
    return kubectl_json("-n", namespace, "exec", pod, "--", "lncli", "--lnddir=/data/.lnd", "--network=regtest", *args)


def write_evidence(pubkey, channel_point, original_pvc_uid, confirmed_before, confirmed_after, scb_format):
    now = datetime.now(timezone.utc)
    EVIDENCE.mkdir(parents=True, exist_ok=True, mode=0o700)
    EVIDENCE.chmod(0o700)
    path = EVIDENCE / f"regtest-recovery-{now.strftime('%Y%m%dT%H%M%S.%fZ')}.json"
    payload = {
        "schema": "lnd-ops/regtest-recovery/v1",
        "result": "pass",
        "checked_at": now.isoformat().replace("+00:00", "Z"),
        "git_commit": subprocess.check_output(["git", "-C", str(REPO), "rev-parse", "HEAD"], text=True).strip(),
        "recovered_identity_pubkey": pubkey,
        "closed_channel_point": channel_point,
        "original_pvc_uid": original_pvc_uid,
        "original_identity_stopped": True,
        "scb_format": scb_format,
        "scb_integrity": "pass",
        "peer_recorded_close": True,
        "confirmed_balance_before_sat": confirmed_before,
        "confirmed_balance_after_sat": confirmed_after,
        "recovered_funds_increased": confirmed_after > confirmed_before,
    }
    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w") as output:
            json.dump(payload, output, indent=2, sort_keys=True)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.link(temporary, path)
        path.chmod(0o600)
    finally:
        temporary.unlink(missing_ok=True)
    return path


def main():
    if len(sys.argv) != 1:
        sys.exit("Usage: ops/verify-regtest-recovery")
    try:
        namespace = kubectl_json("get", "namespace", "lnd-regtest-recovery", "-o", "json")
    except subprocess.CalledProcessError:
        print("ACTION: run ops/prepare-regtest-recovery after channel and SCB verification", file=sys.stderr)
        return 10
    annotations = namespace["metadata"].get("annotations", {})
    pubkey = annotations["lnd-ops.dev/original-pubkey"]
    channel_point = annotations["lnd-ops.dev/channel-point"]
    confirmed_before = int(annotations["lnd-ops.dev/confirmed-before"])
    local_before = int(annotations["lnd-ops.dev/channel-local-before"])
    recorded_scb_hash = annotations["lnd-ops.dev/scb-sha256"]
    scb_format = annotations.get("lnd-ops.dev/scb-format", "plain-on-encrypted-volume-v1")
    original_pvc_uid = annotations["lnd-ops.dev/original-pvc-uid"]

    original = kubectl_json("-n", "lnd-regtest", "get", "statefulset", "lnd-0", "-o", "json")
    if original["spec"]["replicas"] != 0 or original.get("status", {}).get("readyReplicas", 0) != 0:
        sys.exit("FAIL: original lnd-0 must remain stopped during recovery")
    pvc = kubectl_json("-n", "lnd-regtest", "get", "pvc", "data-lnd-0-0", "-o", "json")
    if pvc["metadata"]["uid"] != original_pvc_uid:
        sys.exit("FAIL: original lnd-0 PVC identity changed")
    if scb_format == "gpg-symmetric-v1":
        host_scb = pathlib.Path.home() / "lnd-ops-backups-encrypted/regtest/lnd-0/channel.backup.gpg"
        record = host_scb.parent / ".last-success"
        try:
            _, plain_hash, cipher_hash, record_format = record.read_text().split()
        except (OSError, ValueError):
            sys.exit("FAIL: encrypted host SCB transfer record is unavailable")
        if record_format != scb_format or plain_hash != recorded_scb_hash:
            sys.exit("FAIL: encrypted host SCB transfer record differs from prepared recovery")
        if not host_scb.is_file() or hashlib.sha256(host_scb.read_bytes()).hexdigest() != cipher_hash:
            sys.exit("FAIL: encrypted host SCB ciphertext differs from its transfer record")
    elif scb_format == "plain-on-encrypted-volume-v1":
        if sys.platform == "darwin":
            host_scb = pathlib.Path.home() / "lnd-ops-backups/regtest/lnd-0/channel.backup"
        elif sys.platform == "linux" and any(word in pathlib.Path("/proc/sys/kernel/osrelease").read_text().lower() for word in ("microsoft", "wsl")):
            windows_mount = subprocess.check_output([REPO / "ops/windows-drive"], text=True).strip()
            host_scb = pathlib.Path(windows_mount) / "lnd-ops-backups/regtest/lnd-0/channel.backup"
        else:
            sys.exit("FAIL: unsupported host for SCB verification")
        if not host_scb.is_file() or hashlib.sha256(host_scb.read_bytes()).hexdigest() != recorded_scb_hash:
            sys.exit("FAIL: host SCB does not match prepared recovery copy")
    else:
        sys.exit("FAIL: unsupported prepared SCB format")
    pod_scb_hash = subprocess.check_output(
        ["kubectl", "-n", "lnd-regtest-recovery", "exec", "lnd-0-0", "--", "sha256sum", "/data/recovery.backup"],
        text=True, stderr=subprocess.DEVNULL,
    ).split()[0]
    if pod_scb_hash != recorded_scb_hash:
        sys.exit("FAIL: recovery Pod SCB differs from verified host copy")
    recovery = lncli("lnd-regtest-recovery", "lnd-0-0", "getinfo")
    if recovery["identity_pubkey"] != pubkey:
        sys.exit("FAIL: recovered node public key differs from original")
    active = lncli("lnd-regtest-recovery", "lnd-0-0", "listchannels").get("channels", [])
    if any(channel.get("channel_point") == channel_point and channel.get("active") for channel in active):
        sys.exit("FAIL: recovered channel is still active")
    closed = lncli("lnd-regtest", "lnd-1-0", "closedchannels").get("channels", [])
    if not any(channel.get("channel_point") == channel_point for channel in closed):
        print("PENDING: peer has not recorded the recovered channel close", file=sys.stderr)
        return 10
    confirmed_after = int(lncli("lnd-regtest-recovery", "lnd-0-0", "walletbalance").get("confirmed_balance", 0))
    if confirmed_after <= confirmed_before + local_before // 2:
        print("PENDING: recovered channel funds have not appeared in confirmed on-chain balance", file=sys.stderr)
        return 10
    evidence = write_evidence(pubkey, channel_point, original_pvc_uid, confirmed_before, confirmed_after, scb_format)
    print(f"OK recovered pubkey={pubkey}; closed channel={channel_point}; confirmed balance {confirmed_before}->{confirmed_after} sat")
    print(f"Evidence: {evidence}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (subprocess.CalledProcessError, KeyError, ValueError) as error:
        print(f"Recovery verification unavailable: {type(error).__name__}", file=sys.stderr)
        sys.exit(10)
