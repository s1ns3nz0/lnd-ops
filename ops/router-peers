#!/usr/bin/env python3
"""Approve peer addresses interactively, or reconnect only previously approved peers."""
import argparse
import json
import subprocess
import sys

from router_peers import reconnect, wizard
from router_store import state_directory


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--reconnect", action="store_true")
    args = parser.parse_args(argv)
    try:
        if args.reconnect:
            print(json.dumps(reconnect(state_directory()), ensure_ascii=False))
            return 0
        if not sys.stdin.isatty():
            raise ValueError("peer 등록에는 대화형 승인이 필요합니다")
        return 0 if wizard(state_directory()) else 10
    except (EOFError, KeyboardInterrupt):
        print("\n  peer 등록을 중단했습니다.")
        return 10
    except (ValueError, KeyError, TypeError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
        print(f"  peer 연결 보류: {exc}", file=sys.stderr)
        return 10


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
