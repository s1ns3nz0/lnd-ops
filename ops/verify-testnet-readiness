#!/usr/bin/env python3
"""Read-only check for persistent testnet peer, channel, and payment readiness."""

import json
import os
import pathlib
import subprocess
import sys
import time


STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state")) / "lnd-ops"
os.environ.setdefault("KUBECONFIG", str(STATE / "kubeconfig"))
BASE = ["kubectl", "-n", "lnd-testnet", "exec", "lnd-0-0", "-c", "lnd", "--", "lncli", "--lnddir=/data/.lnd", "--network=testnet"]


def lncli(*arguments):
    result = subprocess.run(BASE + list(arguments), text=True, capture_output=True, timeout=60)
    if result.returncode:
        raise RuntimeError("unlock the persistent testnet wallet")
    return json.loads(result.stdout)


def main():
    try:
        info = lncli("getinfo")
        if not info.get("synced_to_chain") or not info.get("synced_to_graph"):
            raise RuntimeError("wait for testnet chain and graph synchronization")
        peers = lncli("listpeers").get("peers", [])
        if not peers:
            raise RuntimeError("connect a reviewed external testnet peer")
        channels = lncli("listchannels").get("channels", [])
        if not any(item.get("active") and not item.get("private") for item in channels):
            raise RuntimeError("open and confirm an active public testnet channel")
        now = time.time()
        payments = lncli("listpayments", "--include_incomplete").get("payments", [])
        invoices = lncli("listinvoices").get("invoices", [])
        sent = any(item.get("status") == "SUCCEEDED" and now - float(item.get("creation_date", 0)) <= 3600 for item in payments)
        received = any(item.get("state") == "SETTLED" and now - float(item.get("settle_date", 0)) <= 3600 for item in invoices)
        if not sent or not received:
            raise RuntimeError("make a successful outgoing and incoming testnet payment within the last hour")
    except (RuntimeError, ValueError, TypeError, json.JSONDecodeError, OSError, subprocess.SubprocessError) as error:
        print(f"ACTION: {error}", file=sys.stderr)
        return 10
    print("OK persistent testnet node: synced peer, public channel, and recent send/receive payments")
    return 0


if __name__ == "__main__":
    sys.exit(main())
