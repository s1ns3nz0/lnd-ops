#!/usr/bin/env python3
"""Foreground Router monitor intended for a host service manager."""
import argparse
import json
import pathlib
import runpy
import signal
import subprocess
import sys
import threading
import time

from router_monitor import Observations, status
from router_peers import reconnect
from router_rpc import environment
from router_store import operation_lock, state_directory, read
from router_worker import StatusWorker

HERE = pathlib.Path(__file__).resolve().parent


def probe():
    snapshot = runpy.run_path(str(HERE / "verify-router"))["snapshot"]
    result = snapshot()
    if result.get("identity") and result.get("synced_to_chain") and result["code"] not in ("query_error", "wrong_network"):
        try:
            result["reconnect"] = reconnect(state_directory())
        except (RuntimeError, ValueError, KeyError, TypeError, OSError, subprocess.SubprocessError) as exc:
            # An operation lock held by the interactive UI is not permission
            # to bypass its transaction. Try on the next bounded observation.
            result["reconnect_error"] = str(exc)
    return result


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--probe", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--status", action="store_true", help="show local monitor and observation freshness without starting it")
    parser.add_argument("--json", action="store_true", help="JSON status output (with --status)")
    args = parser.parse_args(argv)
    if args.json and not args.status or args.probe and args.status:
        parser.error('--json requires --status; --probe and --status are exclusive')
    if args.status:
        try:
            value = status(read(state_directory(), 'monitor.json'))
            if args.json:
                print(json.dumps(value, ensure_ascii=False))
            else:
                print('  지속 감시: ' + value['message'])
                for key, label in (('heartbeat_age_seconds', '감시 생존 확인'), ('observation_age_seconds', '노드 상태 조회')):
                    elapsed = value.get(key)
                    print(f"  {label}: " + (f'{elapsed:.0f}초 전' if elapsed is not None else '유효한 기록 없음'))
                print('  외부 접속: ' + ('확인 (운영자 외부 실행)' if value['external_reachability'] == 'operator_attested' else '새 검증 필요'))
                print('  외부 검사 만료는 라우팅 장애를 뜻하지 않습니다.')
            return 0
        except (ValueError, OSError) as exc:
            print(f'감시 기록 조회 실패: {exc}', file=sys.stderr)
            return 1
    if args.probe:
        print(json.dumps(probe(), ensure_ascii=False))
        return 0
    stop = threading.Event()
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: stop.set())
    root = state_directory()
    observations = Observations()
    worker = StatusWorker([sys.executable, str(HERE / "router-monitor"), "--probe"],
                          env=environment(), interval=10, timeout=180)
    try:
        with operation_lock(root, "monitor.lock"):
            try:
                while not stop.is_set():
                    result = worker.tick()
                    if result is not None:
                        for event in observations.accept(result):
                            print(json.dumps(event | {"at": time.time()}, ensure_ascii=False), flush=True)
                    for event in observations.check_freshness():
                        print(json.dumps(event | {"at": time.time()}, ensure_ascii=False), flush=True)
                    observations.save(root, probing=worker.process is not None)
                    stop.wait(5)
            finally:
                worker.close()
                observations.save(root, running=False)
        return 0
    except (RuntimeError, OSError, ValueError) as exc:
        print(f"Router 감시 시작/유지 실패: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
