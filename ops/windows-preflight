#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
osrelease_file=${LND_OPS_OSRELEASE_FILE:-/proc/sys/kernel/osrelease}
if [[ "$(uname -s)" != Linux ]] || ! grep -qiE '(microsoft|wsl)' "$osrelease_file" 2>/dev/null; then
  echo 'FAIL: Windows preflight must run inside WSL 2' >&2
  exit 1
fi
case "$(uname -m)" in
  x86_64|amd64) ;;
  *) echo "FAIL: Windows MVP target requires amd64 WSL; found $(uname -m)" >&2; exit 1 ;;
esac
[[ "$(ps -p 1 -o comm= 2>/dev/null | tr -d ' ')" == systemd ]] || {
  echo 'FAIL: WSL systemd is inactive; enable [boot] systemd=true in /etc/wsl.conf' >&2
  exit 1
}
[[ -n "${WSL_DISTRO_NAME:-}" ]] || { echo 'FAIL: WSL_DISTRO_NAME is unavailable' >&2; exit 1; }
for tool in powershell.exe wslpath systemctl sudo; do
  command -v "$tool" >/dev/null 2>&1 || { echo "FAIL: $tool is unavailable in WSL" >&2; exit 1; }
done
script=$(wslpath -w "$repo_dir/ops/windows-host-state.ps1")
state=$(powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass \
  -File "$script" -DistroName "$WSL_DISTRO_NAME" | tr -d '\r')
printf '%s' "$state" | python3 -c '
import json, sys
state = json.load(sys.stdin)
assert state["wslVersion"] == 2
assert "Windows 11" in state["osCaption"]
assert state["backingDrive"].endswith(":")
print("OK: {}; WSL 2 distro={}; backing drive={}".format(
    state["osCaption"], state["distroName"], state["backingDrive"]
))
'
