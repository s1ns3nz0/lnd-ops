#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
osrelease_file=${LND_OPS_OSRELEASE_FILE:-/proc/sys/kernel/osrelease}
if [[ "$(uname -s)" != Linux ]] || ! grep -qiE '(microsoft|wsl)' "$osrelease_file" 2>/dev/null; then
  echo 'FAIL: Windows preflight must run inside WSL 2' >&2
  exit 1
fi
case "$(uname -m)" in
  x86_64|amd64) ;;
  *) echo "FAIL: Windows MVP target requires amd64 WSL; found $(uname -m)" >&2; exit 1 ;;
esac
[[ "$(ps -p 1 -o comm= 2>/dev/null | tr -d ' ')" == systemd ]] || {
  echo 'FAIL: WSL systemd is inactive; enable [boot] systemd=true in /etc/wsl.conf' >&2
  exit 1
}
for tool in wslpath systemctl sudo; do
  command -v "$tool" >/dev/null 2>&1 || { echo "FAIL: $tool is unavailable in WSL" >&2; exit 1; }
done
powershell=$(command -v powershell.exe 2>/dev/null || true)
if [[ -z "$powershell" && -x /mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe ]]; then
  powershell=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
fi
[[ -n "$powershell" ]] || { echo 'FAIL: powershell.exe is unavailable in WSL' >&2; exit 1; }
distro_name=${WSL_DISTRO_NAME:-}
if [[ -z "$distro_name" ]]; then
  windows_root=$(wslpath -w / | tr -d '\r')
  distro_name=$(python3 -c 'import sys; p=[x for x in sys.argv[1].split("\\") if x]; print(p[1] if len(p) >= 2 and p[0] in ("wsl.localhost", "wsl$") else "")' "$windows_root")
fi
[[ "$distro_name" =~ ^[A-Za-z0-9._-]+$ ]] || { echo 'FAIL: cannot determine the current WSL distribution name' >&2; exit 1; }
script=$(wslpath -w "$repo_dir/ops/windows-host-state.ps1")
state=$("$powershell" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass \
  -File "$script" -DistroName "$distro_name" | tr -d '\r')
printf '%s' "$state" | python3 -c '
import json, sys
state = json.load(sys.stdin)
assert state["wslVersion"] == 2
assert "Windows 11" in state["osCaption"]
assert state["backingDrive"].endswith(":")
assert state["firewallProtected"] is True
print("OK: {}; WSL 2 distro={}; backing drive={}".format(
    state["osCaption"], state["distroName"], state["backingDrive"]
))
'
