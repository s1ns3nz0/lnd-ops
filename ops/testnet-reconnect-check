#!/usr/bin/env python3
"""Prove peer and channel recovery across an operator-controlled LND Pod restart."""

import json
import os
import pathlib
import stat
import subprocess
import sys
from datetime import datetime, timezone


STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state")) / "lnd-ops"
PENDING = STATE / "evidence/testnet-reconnect-pending.json"
os.environ.setdefault("KUBECONFIG", str(STATE / "kubeconfig"))
BASE = ["kubectl", "-n", "lnd-testnet", "exec", "lnd-0-0", "-c", "lnd", "--", "lncli", "--lnddir=/data/.lnd", "--network=testnet"]


class Gate(Exception):
    pass


class Failure(Exception):
    pass


def command(arguments, timeout=120):
    result = subprocess.run(arguments, text=True, capture_output=True, timeout=timeout)
    if result.returncode:
        detail = (result.stderr or result.stdout).strip().splitlines()
        raise Failure(detail[-1] if detail else f"command failed: {arguments[0]}")
    return result.stdout


def call(*arguments):
    try:
        return json.loads(command(BASE + list(arguments)))
    except json.JSONDecodeError as exc:
        raise Failure(f"malformed lncli JSON for {arguments[0]}") from exc


def snapshot(unready_is_gate=False):
    try:
        info = call("getinfo")
        peers = {item.get("pub_key") for item in call("listpeers").get("peers", []) if item.get("pub_key")}
        channels = call("listchannels").get("channels", [])
    except Failure as exc:
        if unready_is_gate:
            raise Gate("unlock the restarted wallet and wait for LND RPC readiness") from exc
        raise
    try:
        active = [
            item for item in channels
            if item.get("active") and not item.get("private") and int(item.get("capacity", 0)) > 0
            and item.get("remote_pubkey") in peers
        ]
    except (TypeError, ValueError, AttributeError) as exc:
        raise Failure("testnet channel data is malformed") from exc
    if not info.get("identity_pubkey") or not active:
        raise Gate("an unlocked node with an active public channel and connected peer is required")
    try:
        pod = json.loads(command(["kubectl", "-n", "lnd-testnet", "get", "pod", "lnd-0-0", "-o", "json"]))
    except json.JSONDecodeError as exc:
        raise Failure("malformed Kubernetes Pod JSON") from exc
    return {
        "node_key": info["identity_pubkey"],
        "pod_uid": pod["metadata"]["uid"],
        "channel_points": sorted(item["channel_point"] for item in active),
        "peer_pubkeys": sorted({item["remote_pubkey"] for item in active}),
    }


def private_write(path, payload):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    path.parent.chmod(0o700)
    temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w") as output:
            json.dump(payload, output, indent=2, sort_keys=True)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        path.chmod(0o600)
    finally:
        temporary.unlink(missing_ok=True)


def prepare():
    before = snapshot()
    payload = {
        "schema": "lnd-ops/testnet-reconnect/v1",
        "prepared_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "before": before,
    }
    private_write(PENDING, payload)
    print(f"OK reconnect baseline: {len(before['channel_points'])} active public channel(s), {len(before['peer_pubkeys'])} connected peer(s)")
    print(f"Pending evidence: {PENDING}")
    print("NEXT: delete only pod/lnd-0-0, unlock the existing wallet, then run ops/testnet-reconnect-check verify")
    return 0


def verify():
    if not PENDING.is_file() or PENDING.is_symlink():
        raise Gate("run ops/testnet-reconnect-check prepare before restarting the Pod")
    metadata = PENDING.stat()
    if stat.S_IMODE(metadata.st_mode) != 0o600 or metadata.st_uid != os.getuid():
        raise Failure("pending reconnect evidence must be operator-owned mode 0600")
    try:
        payload = json.loads(PENDING.read_text())
        before = payload["before"]
        prepared = datetime.fromisoformat(payload["prepared_at"].replace("Z", "+00:00"))
    except (OSError, json.JSONDecodeError, KeyError, TypeError, ValueError) as exc:
        raise Failure("pending reconnect evidence is malformed") from exc
    if payload.get("schema") != "lnd-ops/testnet-reconnect/v1":
        raise Failure("pending reconnect evidence schema is invalid")
    after = snapshot(unready_is_gate=True)
    if after["pod_uid"] == before["pod_uid"]:
        raise Gate("restart pod/lnd-0-0 before verifying reconnect behavior")
    for field in ("node_key", "channel_points", "peer_pubkeys"):
        if after[field] != before[field]:
            raise Failure(f"Pod restart changed or did not restore {field}")
    elapsed = int((datetime.now(timezone.utc) - prepared).total_seconds())
    now = datetime.now(timezone.utc)
    result = dict(payload, result="pass", verified_at=now.isoformat().replace("+00:00", "Z"), elapsed_seconds=elapsed, after=after)
    destination = PENDING.with_name(f"testnet-reconnect-{now.strftime('%Y%m%dT%H%M%S.%fZ')}.json")
    private_write(destination, result)
    PENDING.unlink()
    print(f"OK Pod restart preserved node identity and restored {len(after['channel_points'])} active public channel peer(s)")
    print(f"Evidence: {destination}")
    return 0


def main(arguments):
    if arguments not in (["prepare"], ["verify"]):
        print("Usage: ops/testnet-reconnect-check prepare|verify", file=sys.stderr)
        return 2
    try:
        return prepare() if arguments == ["prepare"] else verify()
    except Gate as exc:
        print(f"ACTION: {exc}", file=sys.stderr)
        return 10
    except (Failure, OSError, KeyError, TypeError, ValueError, subprocess.TimeoutExpired) as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
