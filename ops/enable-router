#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
external_ip=''

usage() {
  echo 'Usage: ops/enable-router --external-ip PUBLIC_HOST' >&2
  exit 2
}

while (($#)); do
  case "$1" in
    --external-ip) [[ $# -ge 2 ]] || usage; external_ip=$2; shift 2 ;;
    *) usage ;;
  esac
done

[[ "$external_ip" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] || {
  echo 'PUBLIC_HOST must be a bare public DNS name or IP address' >&2
  exit 2
}

"$repo_dir/ops/deploy" testnet --router --router-external-ip "$external_ip"
echo 'OK: Router P2P Service is enabled at Kubernetes NodePort 30973.'
echo 'ACTION: forward public TCP 9735 to this host NodePort, then run ops/configure-router-policy --confirm "APPLY ROUTER POLICY".'
