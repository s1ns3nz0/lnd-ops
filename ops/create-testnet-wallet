#!/usr/bin/env bash
set -euo pipefail

[[ $# -eq 0 ]] || { echo 'Usage: ops/create-testnet-wallet' >&2; exit 2; }
[[ -t 0 && -t 1 ]] || {
  echo 'Run in an interactive terminal; wallet credentials are never accepted through arguments or pipes' >&2
  exit 2
}
export KUBECONFIG=${KUBECONFIG:-${XDG_STATE_HOME:-$HOME/.local/state}/lnd-ops/kubeconfig}
state=$(kubectl -n lnd-testnet exec lnd-0-0 -c lnd -- \
  lncli --lnddir=/data/.lnd --network=testnet state | \
  python3 -c 'import json,sys; print(json.load(sys.stdin)["state"])')
[[ $state == NON_EXISTING ]] || {
  echo "FAIL: testnet wallet state is $state; refusing to replace an existing wallet" >&2
  exit 1
}

cat <<'EOF'
Creating this host's persistent testnet wallet.

1. Choose a unique wallet password and store it outside Git and chat.
2. Answer 'n' when asked for an existing cipher seed.
3. Choose whether to protect the seed with an optional cipher passphrase.
4. Record the 24 words offline and off this host before confirming.

This wallet belongs only to this host. Never copy the Windows wallet or its PVC.
EOF
kubectl -n lnd-testnet exec -it lnd-0-0 -c lnd -- \
  lncli --lnddir=/data/.lnd --network=testnet create
echo 'OK: persistent testnet wallet created; run ops/testnet-status'
