#!/usr/bin/env python3
"""Interactively approve a bounded testnet public channel opening."""
import argparse
import json
import pathlib
import subprocess
import sys

from router_channels import preview, reconcile, submit
from router_rpc import call, require_testnet, environment
from router_store import operation_lock, state_directory
from router_peers import wizard as peer_wizard


def positive_integer(prompt):
    while True:
        answer = input(prompt).strip()
        if answer.lower() == "s":
            raise EOFError
        try:
            value = int(answer)
            if value > 0:
                return value
        except ValueError:
            pass
        print("  1 이상의 정수를 입력하세요. s=취소")


def show_backup_status():
    """Report current local SCB freshness without changing funding or backup state."""
    print('  채널 백업 상태를 확인합니다…', flush=True)
    try:
        result = subprocess.run(
            [str(pathlib.Path(__file__).with_name('backup-status-encrypted')),
             'testnet', 'lnd-0', '--read-only'],
            env=environment(), capture_output=True, text=True, timeout=15)
        if result.returncode == 0:
            print('  백업: 현재 SCB와 로컬 암호화 사본이 일치합니다.')
        elif result.returncode == 10:
            print('  백업: 로컬 암호화 사본 또는 저장 기록이 없습니다.')
        else:
            print('  백업: 일치를 확인하지 못했습니다. 갱신 또는 조회 점검이 필요합니다.')
    except (OSError, subprocess.SubprocessError):
        print('  백업: 조회를 완료하지 못했습니다. 채널 개설 결과와 별개입니다.')
    print('  개설 대기 채널이 백업에 포함됐다는 뜻은 아닙니다.')
    print('  이 결과는 외부 사본·복구 성공을 증명하지 않습니다.')
    print('  채널 활성화 뒤 Router 화면의 o → 5 암호화 백업 상태 확인을 선택하세요.')
    print('  백업이 없거나 오래됐으면 o → 4 testnet 암호화 SCB 백업으로 갱신하세요.')


def wizard():
    root = state_directory()
    with operation_lock(root):
        request = reconcile(root)
    if request and request["state"] in ("submitting", "uncertain", "broadcast", "closing"):
        labels = {"submitting": "제출 결과 확인 중", "uncertain": "결과를 확정하지 못함",
                  "broadcast": "funding 확인 대기", "closing": "기존 채널 종료 처리 중"}
        print(f"  기존 개설 요청: {labels[request['state']]}")
        print(f"  채널: {request.get('channel_point', '결과 확인 필요')}")
        print(f"  요청 식별자: {request['memo']}")
        print(f"  상대 노드: {request['peer']} / 승인 금액: {request['amount_sat']} sat")
        print("  이전 요청을 확인하기 전에는 새 funding 거래를 만들지 않습니다.")
        if request['state'] == 'uncertain':
            print("  pending 목록이 비어 있어도 실패로 단정할 수 없습니다. 요청 기록을 삭제하지 마세요.")
            print("  상대 운영자와 funding 상태를 확인한 뒤 재시도하면 결과만 다시 조회합니다.")
        show_backup_status()
        return 10
    if request and request['state'] in ('active', 'confirmed', 'closed'):
        show_backup_status()
    if request and request['state'] == 'closed':
        print('  이전 요청의 채널 종료가 확인됐습니다. 새 개설에는 금액·예산을 다시 승인해야 합니다.')
    info = call("getinfo")
    require_testnet(info)
    channels = call("listchannels").get("channels", [])
    wallet = call("walletbalance")
    print(f"  확정 잔액: {wallet.get('confirmed_balance', 0)} sat")
    print(f"  anchor 예약금: {wallet.get('reserved_balance_anchor_chan', 0)} sat")
    print(f"  기존 채널: {len(channels)}개")
    existing = {c.get("remote_pubkey") for c in channels}
    peers = [p for p in call("listpeers").get("peers", []) if p["pub_key"] not in existing]
    print("  연결된 후보입니다. 연결 상태만으로 운영자의 신뢰성을 보증하지 않습니다.")
    for index, peer in enumerate(peers, 1):
        print(f"  [{index}] {peer['pub_key']}\n      {peer.get('address', '주소 미확인')}")
    if not peers:
        print("  새 후보 연결이 필요합니다. peer 운영자와 주소를 확인하고 등록합니다.")
        peer_wizard(root)
        print("  peer 연결 후 개설 작업을 다시 선택하세요.")
        return 10
    number = positive_integer(f"  peer 선택 [1-{len(peers)}, s=취소]: ")
    if number > len(peers):
        raise ValueError("목록에 없는 peer입니다")
    amount = positive_integer("  새 공개 채널 금액 (sat, s=취소): ")
    rate = positive_integer("  funding 수수료율 (sat/vB, s=취소): ")
    fee_cap = positive_integer("  funding 최대 수수료 (sat, s=취소): ")
    total_cap = positive_integer("  기존·대기 채널을 포함한 전체 용량 상한 (sat, s=취소): ")
    plan = preview(peers[number - 1]["pub_key"], amount, rate, fee_cap, total_cap)
    print(f"  공개 채널: {plan['peer']}")
    print(f"  묶이는 자금: {amount} sat / 상대에게 즉시 주는 금액: 0 sat")
    print(f"  수수료율: {rate} sat/vB / 수수료 상한: {fee_cap} sat")
    print(f"  입력 크기로 계산한 보수적 수수료 상한: {plan['fee_upper_bound_sat']} sat")
    print(f"  전체 용량: {plan['committed_sat']} → {plan['committed_sat'] + amount} / {total_cap} sat")
    if input("  실행 승인 [OPEN 입력=개설, 그 외=취소]: ").strip() != "OPEN":
        return 10
    record = submit(root, plan)
    print(f"  funding 요청 완료: {record['channel_point']}")
    print("  블록 확인과 공개 전파를 기다립니다.")
    show_backup_status()
    return 10


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--reconcile", action="store_true", help="inspect an existing request; never open a channel")
    args = parser.parse_args(argv)
    try:
        if args.reconcile:
            with operation_lock(state_directory()):
                print(json.dumps(reconcile(state_directory()), ensure_ascii=False))
            return 0
        if not sys.stdin.isatty():
            raise ValueError("채널 개설은 대화형 승인 입력이 필요합니다")
        return wizard()
    except (EOFError, KeyboardInterrupt):
        print("\n  개설 입력을 중단했습니다. 제출된 요청이 있으면 다음 실행에서 재확인합니다.")
        return 10
    except (ValueError, KeyError, TypeError, OSError, RuntimeError, subprocess.SubprocessError) as exc:
        print(f"  개설 보류: {exc}", file=sys.stderr)
        return 10


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
