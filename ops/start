def public_endpoint_candidates():
    candidates = []
    try:
        with urlopen("https://api.ipify.org", timeout=5) as response:
            address = response.read().decode().strip()
        if ipaddress.ip_address(address).is_global:
            try:
                hostname = socket.gethostbyaddr(address)[0]
            except OSError:
                hostname = None
            candidates.append((address, hostname))
    except (OSError, ValueError):
        pass
    return candidates


