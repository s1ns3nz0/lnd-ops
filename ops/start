    return message


def display_width(text):
    return sum(
        0 if unicodedata.combining(character) else 2 if unicodedata.east_asian_width(character) in ("F", "W") else 1
        for character in text
    )


def fit_terminal_line(text, columns):
    """Clip a status row by terminal display cells so ANSI cursor movement stays aligned."""
    limit = max(1, columns - 1)
    if display_width(text) <= limit:
        return text
    if limit == 1:
        return "."
    fitted = []
    used = 0
    for character in text:
        width = 0 if unicodedata.combining(character) else 2 if unicodedata.east_asian_width(character) in ("F", "W") else 1
        if used + width > limit - 1:
            break
        fitted.append(character)
        used += width
    return "".join(fitted) + "."


