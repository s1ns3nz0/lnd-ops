RESET = "\033[0m"
CYAN = "\033[36m"
GREEN = "\033[32m"
YELLOW = "\033[33m"


def paint(text, color):
    return f"{color}{text}{RESET}" if sys.stdout.isatty() and "NO_COLOR" not in os.environ else text


def section(title, color=CYAN):
    print(paint("=" * 64, color))
    print(paint(f"  {title}", color))
    print(paint("=" * 64, color))


def display(command):
    return " ".join(command)


def runtime_environment():
    return os.environ | {"KUBECONFIG": os.environ.get("KUBECONFIG", str(STATE / "kubeconfig"))}


def wallet_pvc_snapshot():
    snapshot = {}
    for namespace, claim in (("lnd-testnet", "data-lnd-0-0"), ("lnd-regtest", "data-lnd-0-0"), ("lnd-regtest", "data-lnd-1-0")):
        try:
            result = subprocess.run(
                ["kubectl", "-n", namespace, "get", "pvc", claim, "-o", "jsonpath={.metadata.uid}"],
                text=True, capture_output=True, env=runtime_environment(), timeout=15,
            )
        except (OSError, subprocess.TimeoutExpired):
            return snapshot
        if result.returncode == 0 and result.stdout.strip():
            snapshot[f"{namespace}/{claim}"] = result.stdout.strip()
    return snapshot


def load_selection():
    if not SELECTION.exists():
        return None
    if SELECTION.is_symlink() or SELECTION.stat().st_uid != os.getuid() or SELECTION.stat().st_mode & 0o777 != 0o600:
        raise RuntimeError("unsafe wallet selection file")
    data = json.loads(SELECTION.read_text())
    if data.get("schema") != "lnd-ops/wallet-selection/v1" or data.get("choice") not in WALLET_CHOICES:
        raise RuntimeError("invalid wallet selection file")
    return data


def select_wallet(choice):
    title, mode, claims = WALLET_CHOICES[choice]
    snapshot = wallet_pvc_snapshot()
    if mode == "existing" and not all(claim in snapshot for claim in claims):
        raise RuntimeError(f"{title} PVC를 찾을 수 없습니다; 새 workspace를 선택하거나 지갑 상태를 확인하세요")
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    STATE.chmod(0o700)
    temporary = SELECTION.with_name(f".{SELECTION.name}.tmp-{os.getpid()}")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "w") as output:
        json.dump({"schema": "lnd-ops/wallet-selection/v1", "choice": choice, "pvc_uids": {claim: snapshot[claim] for claim in claims}}, output, sort_keys=True)
        output.write("\n")
    os.replace(temporary, SELECTION)
    SELECTION.chmod(0o600)
    print(f"선택됨: {title}")


def selection_gate():
    selected = load_selection()
    if selected is None:
        return "먼저 `wallet` 명령으로 기존 또는 새 wallet workspace를 선택하세요"
    title, mode, _ = WALLET_CHOICES[selected["choice"]]
    if mode == "new":
        return f"{title}는 별도 PVC/identity 생성 단계가 필요합니다. 기존 지갑은 변경하지 않습니다"
    current = wallet_pvc_snapshot()
    if any(current.get(claim) != uid for claim, uid in selected["pvc_uids"].items()):
        return f"선택한 {title} PVC identity가 바뀌었습니다; 실행을 중단합니다"
    return None


def prompt_wallet_selection():
    print("\n지갑 workspace 선택")
    for number, (choice, (title, mode, _)) in enumerate(WALLET_CHOICES.items(), 1):
        suffix = "기존 PVC를 고정" if mode == "existing" else "기존 지갑을 건드리지 않는 별도 workspace"
        print(f"[{number}] {title} — {suffix}")
    while True:
        try:
            answer = input("선택 [1-4]: ").strip()
        except EOFError:
            print()
            return False
        if answer.isdigit() and 1 <= int(answer) <= len(WALLET_CHOICES):
            select_wallet(list(WALLET_CHOICES)[int(answer) - 1])
            return True
        print("1부터 4 중 하나를 입력하세요.", file=sys.stderr)


def wallet_banner():
    try:
        result = subprocess.run(
            [str(REPO / "ops/wallet-status"), "--format", "banner"], cwd=REPO,
            env=runtime_environment(), text=True, capture_output=True, timeout=95,
        )
    except (OSError, subprocess.TimeoutExpired):
        return "WALLET STATUS\n  상태를 읽을 수 없음"
    if result.returncode:
        return "WALLET STATUS\n  상태를 읽을 수 없음"
    return result.stdout.strip() or "WALLET STATUS\n  지갑 없음"


def execute(command, dry_run=False):
    if command not in SAFE_AUTOMATIC_COMMANDS:
        raise RuntimeError(f"refusing a non-preserving automatic command: {display(command)}")
    print(f"  {'PLAN' if dry_run else 'RUN '} {display(command)}", flush=True)
    if dry_run:
        return 0
    before = wallet_pvc_snapshot()
    result = subprocess.run([str(REPO / command[0]), *command[1:]], cwd=REPO, env=runtime_environment()).returncode
    after = wallet_pvc_snapshot()
    changed = {name: (uid, after.get(name)) for name, uid in before.items() if after.get(name) != uid}
    if changed:
        raise RuntimeError(f"wallet PVC identity changed during {display(command)}: {changed}")
    return result


def existing_namespace(namespaces):
    if not namespaces:
        return False
    environment = runtime_environment()
    for namespace in namespaces:
        try:
            result = subprocess.run(["kubectl", "get", "namespace", namespace], text=True, capture_output=True, env=environment)
        except FileNotFoundError:
            return False
        if result.returncode == 0:
            return True
    return False


def inspect(number):
    phase = PHASES[number]
    command = phase["probe"]
    if not command:
        return "manual", "operator-held evidence or rehearsal"
    if not (REPO / command[0]).is_file():
        return "failed", f"missing repository command: {command[0]}"
    result = subprocess.run([str(REPO / command[0]), *command[1:]], cwd=REPO, text=True, capture_output=True, env=runtime_environment())
    if result.returncode == 0:
        return "complete", "verification passed"
    if result.returncode == 10:
        return "partial", "operator gate pending"
    if result.returncode == 127:
        return "missing", "required host tool is unavailable"
    if existing_namespace(phase["namespaces"]):
        return "partial", "existing Kubernetes resources did not pass verification"
    detail = (result.stderr or result.stdout).strip().splitlines()
    return "failed", detail[-1] if detail else "verification failed without output"


