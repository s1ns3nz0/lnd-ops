def execute(command, dry_run=False, fresh_profile=None):
    if command not in SAFE_AUTOMATIC_COMMANDS:
        raise RuntimeError(f"refusing a non-preserving automatic command: {display(command)}")
    print(f"  {'PLAN' if dry_run else 'RUN '} {display(command)}", flush=True)
    if dry_run:
        return 0
    before = wallet_pvc_snapshot(strict=True) if fresh_profile else wallet_pvc_snapshot()
    if fresh_profile and any(name.startswith(f"lnd-{fresh_profile}/") for name in before):
        raise RuntimeError("workspace PVC가 생성되었습니다. wallet에서 기존 지갑을 선택하세요")
    result = subprocess.run([str(REPO / command[0]), *command[1:]], cwd=REPO, env=runtime_environment()).returncode
    after = wallet_pvc_snapshot(strict=True) if fresh_profile else wallet_pvc_snapshot()
    changed = {name: (uid, after.get(name)) for name, uid in before.items() if after.get(name) != uid}
    if changed:
        raise RuntimeError(f"wallet PVC identity changed during {display(command)}: {changed}")
    return result


def inspect(number):
    phase = PHASES[number]
    command = phase["probe"]
    if not command:
        return "manual", "operator-held evidence or rehearsal"
    if not (REPO / command[0]).is_file():
        return "failed", f"missing repository command: {command[0]}"
    if phase["namespaces"]:
        try:
            available = subprocess.run(
                ["kubectl", "get", "namespace", phase["namespaces"][0]], text=True, capture_output=True,
                env=runtime_environment(), timeout=20,
            )
        except (OSError, subprocess.TimeoutExpired):
            return "missing", "required infrastructure is not built"
        if available.returncode:
            return "missing", "required infrastructure is not built"
    result = subprocess.run([str(REPO / command[0]), *command[1:]], cwd=REPO, text=True, capture_output=True, env=runtime_environment())
    if result.returncode == 0:
        return "complete", "verification passed"
    if result.returncode == 10:
        detail = (result.stderr or result.stdout).strip().splitlines()
        return "partial", detail[-1] if detail else "operator gate pending"
    if result.returncode == 127:
        return "missing", "required host tool is unavailable"
    detail = (result.stderr or result.stdout).strip().splitlines()
    summary = detail[-1] if detail else "verification failed without output"
    if phase.get("operator_gate"):
        return "partial", summary
    return "failed", summary


