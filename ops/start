        rows += ['  중계 이력 확인. 외부 접속 검사는 별도입니다.',
                 '  e: 외부망 검사 요청 / 결과 가져오기']
    else:
        rows.append('  ' + snapshot.get('message', '상태 조회 중'))
    rows += router_forwarding_rows(snapshot, fresh, limit=5)
    rows += ['  == 조작: 키 입력 후 Enter ==',
             '  r 즉시 재조회 / a 설정·관리 실행 / d 요약·상세',
             '  m 지속 감시 설정 / c 채널 종료',
             '  v 감시 상태 / o 관측·백업 / e 외부 검사',
             '  q 또는 Ctrl+C: 화면 종료 · 노드는 유지',
             '  최근 조회: ' + (time.strftime('%H:%M:%S', time.localtime(last_success)) if last_success else '아직 없음') + (' · 새 조회 필요' if not fresh else ''), clock]
    if compact:
        rows = router_progress_summary(snapshot, fresh, external)
        # Full identity and transaction IDs remain available in the detail view.
        identity = str(snapshot.get('identity') or '확인 불가')
        rows[1] = '  조회 대상: testnet ' + (identity[:12] + '…' + identity[-8:] if len(identity) > 24 else identity)
        rows += [f"  채널: 연결된 활성 공개 {snapshot.get('active_public', '?')}/2 · 개설 대기 {snapshot.get('pending_public', '?')} · 비활성 {snapshot.get('inactive_public', '?')}"]
        rows.append(f"  상대 연결 {snapshot.get('peers', '?')}개" + (' · 이전 조회' if not fresh else ''))
        for channel in snapshot.get('channels', []):
            peer = str(channel.get('peer') or '미확인')
            connected = ('연결됨' if channel.get('peer_connected') else '연결 끊김') if fresh and 'peer_connected' in channel else '연결 미확인'
            active = ('활성' if channel.get('active') else '비활성') if fresh else '상태 미확인'
            rows.append(f'  {peer[:12]}… · {connected} / 채널 {active}')
        for item in snapshot.get('funding', []):
            peer = str(item.get('peer') or '미확인')
            connected = ('연결됨' if item.get('peer_connected') else '연결 끊김') if fresh else '연결 재조회 필요'
            amount = item.get('capacity_sat')
            remaining = item.get('confirmations_until_active')
            rows.append(f"  개설 대기: {peer[:12]}… · {connected}")
            rows.append(f"    채널 용량 {format(amount, ',') if type(amount) is int else '?'} sat · 블록 확인 {remaining if type(remaining) is int else '?'}회 남음")
        if snapshot.get('code') == 'query_error':
            rows.append('  조회 오류: ' + snapshot.get('message', '원인 미확인'))
        rows += router_forwarding_rows(snapshot, fresh)
        rows += ['  d 요약·상세 / r 즉시 재조회 / a 설정·관리',
                 '  e 외부 검사 / c 채널 종료',
                 '  m 백그라운드 감시 / v 감시 상태 / o 관측·백업 / q 나가기',
                 '  최근 조회: ' + (time.strftime('%H:%M:%S', time.localtime(last_success)) if last_success else '아직 없음') + (f' ({max(0, int(now - last_success))}초 전)' if last_success else '') + (' · 조회 중' if snapshot.get('query_running') else ' · 다음 자동 조회 대기'), '  화면 실행 ' + clock.strip()]
    # Wrap by terminal cells; Korean text must not be truncated or double-wrap.
    width = max(4, shutil.get_terminal_size((80, 24)).columns - 1)
    wrapped = []
    for row in rows:
        line = ''
        for char in row:
            if display_width(line + char) > width:
                wrapped.append(line)
                line = '  '
            line += char
        wrapped.append(line)
    if sys.stdout.isatty():
        wrapped.append(ROUTER_INPUT_PROMPT)
    return render_router_lines(wrapped, previous_lines)


def close_router_wait(previous_lines):
    """Finish the live block before printing a prompt or permanent log line."""
    if previous_lines is not None and sys.stdout.isatty():
        print()
    return None


def refresh_router_clock(phase, active_channels, detail, channel_synced_at, started_at, previous_lines):
    """Refresh elapsed time each second while live verification remains on a ten-second cadence."""
    for _ in range(ROUTER_POLL_SECONDS):
        time.sleep(1)
        previous_lines = render_router_wait(
            phase, active_channels, detail, channel_synced_at, started_at, previous_lines
        )
    return previous_lines


def guide_router(number, phase, *, actions_enabled=True):
    section("PHASE 03 · ROUTER PROGRESS", CYAN)
    started_at = time.monotonic()
    previous_lines = None
    snapshot = {"code": "loading", "message": "상태 조회 중"}
    last_success = changed_at = None
    fingerprint = None
    prompted = None
    action_requested = False
    detailed = False
    worker = StatusWorker([str(REPO / "ops/verify-router"), "--json"], env=runtime_environment(),
                          interval=ROUTER_POLL_SECONDS, timeout=60)
    try:
        while True:
            result = worker.tick()
            if result is not None:
                if result.get("checked_at"):
                    last_success = result["checked_at"]
                    current = tuple(sorted((c.get("point", ""), c.get("active"), c.get("private"))
                                           for c in result.get("channels", [])))
                    if current != fingerprint:
                        if fingerprint is not None:
                            changed_at = last_success
                        fingerprint = current
                    snapshot = result
                else:
                    # Preserve last channel snapshot while displaying the error.
                    snapshot = snapshot | result
                code = result["code"]
                if result.get("complete") and actions_enabled:
                    if time.time() >= result.get("external_expires_at", 0) or not 0 <= time.time() - result.get("checked_at", 0) <= 30:
                        worker.request_now()
                        continue
                    close_router_wait(previous_lines)
                    print("  완료: Router 준비·실경유 이력·외부 접속 결과를 확인했습니다.")
                    print("  외부망 위치는 운영자가 확인했습니다.")
                    print("  접속 결과 만료: " + time.strftime("%m-%d %H:%M:%S", time.localtime(result["external_expires_at"])))
                    return "complete"
                if code == "wrong_network":
                    close_router_wait(previous_lines)
                    print("  오류: testnet 노드만 지원합니다.")
                    return "failed"
                action_key = (code, fingerprint, tuple(sorted(result.get('route_blockers', []))))
                if action_requested and action_key != prompted:
                    action_requested = False
                    actions = {
                        "wallet_locked": run_testnet_unlock,
                        "exposure_required": run_router_wizard,
                        "channel_required": lambda: subprocess.run(
                            [str(REPO / "ops/router-channel")], cwd=REPO, env=runtime_environment()),
                        "peer_disconnected": lambda: subprocess.run(
                            [str(REPO / "ops/router-peers")], cwd=REPO, env=runtime_environment()),
                        "policy_required": lambda: run_confirmed(
                            "공개 채널 수수료 정책 적용", ("ops/configure-router-policy", "--confirm", "APPLY ROUTER POLICY")),
                    }
                    if code in actions:
                        previous_lines = close_router_wait(previous_lines)
                        print(f"  다음 작업: {result['message']}")
                        prompted = action_key
                        actions[code]()
                        worker.request_now()
                        continue
                    if code in ("liquidity_required", "peer_disconnected", "funding_review"):
                        previous_lines = close_router_wait(previous_lines)
                        print(f"  필요한 조건: {result['message']}")
                        if code == "liquidity_required":
                            print(f"  시험 금액 {result.get('test_sat', '?')} sat / 수수료 상한 {result.get('fee_limit_sat', '?')} sat")
                            reasons = {
                                'fee_limit': '설정된 routing 수수료가 시험 수수료 상한을 초과합니다.',
                                'outbound_liquidity': '출구 채널의 전송 가능 잔액이 부족합니다.',
                                'inbound_liquidity': '입구 채널의 수신 가능 잔액이 부족합니다.',
                                'outbound_policy': '출구 채널 정책이 시험 금액을 허용하지 않습니다.',
                                'inbound_policy': '상대 채널 정책이 입금 방향의 시험 금액을 허용하지 않습니다.',
                            }
                            for reason in result.get('route_blockers', []):
                                print('  - ' + reasons.get(reason, '채널 경로 조건 확인이 필요합니다.'))
                            print('  잔액 부족과 정책 제한은 해결 방법이 다릅니다. 자동 송금·swap은 실행하지 않습니다.')
                        if code == 'funding_review':
                            print('  단순 대기로 해결되지 않을 수 있습니다. 상대 운영자와 funding 상태를 확인하세요.')
                            print('  실패나 환불 완료로 처리하지 않습니다. 수수료 증액·채널 종료는 자동 실행하지 않습니다.')
                        prompted = action_key
            snapshot = snapshot | {"query_running": worker.process is not None}
            previous_lines = render_router_snapshot(snapshot, changed_at, last_success, started_at, previous_lines, compact=not detailed)
            if sys.stdin.isatty():
                readable, _, _ = select.select([sys.stdin], [], [], 1)
                if readable:
                    answer = sys.stdin.readline().strip().lower()
                    previous_lines = close_router_wait(previous_lines)
                    if answer == "q":
                        return "partial"
                    if answer == "d":
                        detailed = not detailed
                        previous_lines = None
                    if answer == "a":
                        action_requested = True
                        prompted = None
                        worker.request_now()
                    if answer == "c":
                        worker.close()
                        subprocess.run([str(REPO / "ops/router-close")], cwd=REPO, env=runtime_environment())
                        print("  메인 메뉴로 돌아갑니다. channels로 종료 상태를 다시 확인하세요.")
                        return "partial"
                    if answer == "r":
                        prompted = None
                        worker.request_now()
                    if answer == "o":
                        worker.close()
                        router_support_menu()
                        previous_lines = None
                        worker.request_now()
                    if answer == "m":
                        configure_router_service()
                    if answer == "v":
                        subprocess.run([str(REPO / "ops/router-monitor"), "--status"], cwd=REPO, env=runtime_environment())
                    if answer == "e":
                        subprocess.run([str(REPO / "ops/router-observation"), "interactive"], cwd=REPO, env=runtime_environment())
                        worker.request_now()
            else:
                time.sleep(1)
    except (KeyboardInterrupt, EOFError):
        close_router_wait(previous_lines)
        print("  Router 검증을 중단했습니다. 다시 Phase 3을 선택하면 이어서 확인합니다.")
        return "partial"
    finally:
        worker.close()


def run_confirmed(label, command, confirmation="Enter=실행"):
    """Run one named operator action without exposing its command syntax in the UI."""
    try:
        answer = input(f"  {label} [{confirmation}, s=건너뜀]: ").strip()
    except EOFError:
        return False
    if answer.lower() == "s":
        print("  건너뛰었습니다. 현재 Phase 화면에서 상태를 계속 확인합니다.")
        return False
    if confirmation.startswith("TYPE ") and answer != confirmation.removeprefix("TYPE "):
        print("  확인 문구가 일치하지 않아 실행하지 않았습니다.")
        return False
    result = subprocess.run([str(REPO / command[0]), *command[1:]], cwd=REPO, env=runtime_environment())
    if result.returncode == 0:
        print(f"  완료: {label}")
        return True
    print(f"  보류: {label}이 완료되지 않았습니다. 상태를 다시 확인합니다.")
    return False


def configure_router_service():
    print("  터미널을 닫아도 상태를 감시하고 승인된 peer를 재연결합니다.")
    print("  지갑이 잠기면 직접 unlock해야 합니다. 서비스에 암호를 저장하지 않습니다.")
    command = ("ops/router-service", "--install", "--confirm", "INSTALL ROUTER MONITOR")
    if platform.system() == "Darwin":
        vm = os.environ.get("LND_OPS_VM_NAME", "lnd-ops-k3s")
        print(f"  Mac 로그인 후 기존 VM {vm}도 시작할 수 있습니다. 새 VM은 만들지 않습니다.")
        try:
            answer = input("  VM 자동 시작 [y=포함, Enter=감시만]: ").strip().lower()
        except EOFError:
            return False
        if answer not in ("", "y"):
            print("  설정을 취소했습니다.")
            return False
        if answer == "y":
            command += ("--start-vm", "--vm", vm)
    else:
        print("  Linux/WSL 시작 후 감시합니다. Windows에서 WSL을 시작하는 설정은 별도입니다.")
    installed = run_confirmed("호스트 감시 서비스 설치", command, confirmation="TYPE INSTALL ROUTER MONITOR")
    if installed and platform.system() == "Linux" and "microsoft" in platform.release().lower():
        print("  Windows 로그인 시 이 WSL 배포판을 시작하고 실행을 유지할 수 있습니다.")
        print("  Windows 관리자 권한과 기존 포트 전달 갱신 서비스가 필요합니다. 로그인 전에는 시작하지 않습니다.")
        try:
            answer = input("  Windows 로그인 시작 [y=설정, Enter=건너뜀]: ").strip().lower()
        except EOFError:
            return installed
        if answer == "y":
            return run_confirmed("Windows WSL 로그인 시작 등록",
                                 ("ops/windows-router-startup", "--mode", "install", "--confirm", "INSTALL WSL STARTUP"),
                                 confirmation="TYPE INSTALL WSL STARTUP")
    return installed


