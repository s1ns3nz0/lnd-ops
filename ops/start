    print("  Git commit/push는 자동 실행하지 않습니다. 각 단계 후 Git 반영을 확인하세요.")
    try:
        host = input("  대상 설정 [wsl/mac, Enter=wsl]: ").strip() or "wsl"
        if host not in ("wsl", "mac"):
            print("  wsl 또는 mac을 입력하세요.")
            return "partial"
        while True:
            print("  1 준비 파일 생성 / 2 Flux 설치 / 3 Git 연결 / 4 상태 조회")
            print("  5 테스트 설정 변경 / 6 테스트 결과 확인 / 7 LND 인계 파일 생성")
            print("  8 LND 인계 활성화 / 9 인계 검증·증거 저장 / u Git values 수정 / q 돌아가기")
            choice = input("  선택 > ").strip().lower()
            base = ("ops/flux-phase",)
            command = None
            confirmation = "Enter=실행"
            if choice == "q":
                return "partial"
            if choice == "1":
                url = input("  Git URL [Enter=https://github.com/s1ns3nz0/lnd-ops.git]: ").strip() or "https://github.com/s1ns3nz0/lnd-ops.git"
                branch = input("  추적 branch: ").strip()
                secret = input("  기존 flux-system Git Secret 이름 [공개 저장소=Enter]: ").strip()
                command = (*base, "prepare", "--host", host, "--url", url, "--branch", branch, "--secret-name", secret)
            elif choice in ("2", "3", "7", "8"):
                action = {"2": "install", "3": "connect", "7": "export-lnd", "8": "adopt"}[choice]
                command = (*base, action, "--host", host, "--confirm", action.upper())
                confirmation = "TYPE " + action.upper()
                if action == "export-lnd" and (REPO / "gitops/clusters" / host / "workloads/lnd.json").exists():
                    if input("  기존 suspended 인계 준비를 갱신합니까? [y/N]: ").strip().lower() == "y":
                        command += ("--refresh",)
            elif choice == "4":
                command = (*base, "status")
            elif choice in ("5", "6"):
                stage = input("  단계 [baseline/failure/recovery]: ").strip()
                if stage not in ("baseline", "failure", "recovery"):
                    continue
                action = "stage-probe" if choice == "5" else "record-probe"
                command = (*base, action, "--host", host, "--stage", stage)
                if choice == "6":
                    command += ("--confirm", "RECORD-PROBE")
            elif choice == "9":
                if run_confirmed("인계 검증·증거 저장", (*base, "accept", "--host", host, "--confirm", "ACCEPT")):
                    return "complete"
                continue
            elif choice == "u":
                patch = input("  values 변경 JSON 파일 경로: ").strip()
                command = (*base, "edit-values", "--host", host, "--patch", patch)
            if command:
                run_confirmed("Flux " + command[1], command, confirmation)
    except EOFError:
        return "partial"


def guide_operator(number, phase, detail, interactive):
    if phase["id"] == "gitops":
        if interactive:
            return guide_gitops(number, phase)
        print("  다음 작업: 8번 또는 gitops 메뉴에서 Flux 설치·Git 연결을 진행하세요.")
        return "partial"
    if interactive and phase["id"] == "router":
        return guide_router(number, phase)
    if interactive and phase["id"] == "regtest":
        return guide_regtest(number, phase)
    if interactive and phase["id"] == "testnet":
        return guide_testnet(number, phase)
    if interactive and phase["id"] == "loop":
        return guide_loop(number, phase)
    if interactive and phase["id"] == "monitoring":
        return guide_monitoring(number, phase)
    if interactive and phase.get("operator_gate"):
        return guide_evidence_phase(number, phase)
    section(f"PHASE {number:02} · OPERATOR STEP", YELLOW)
    print(f"  현재 상태: {operator_message(phase, detail)}")
    if interactive and phase["id"] == "testnet":
        run_testnet_unlock()
    else:
        print(f"  다음 작업: {manual_steps(phase)[0]}")
    return phase_checkpoint(number, phase)[0]


def display(command):
    return " ".join(command)


def runtime_environment():
    return os.environ | {"KUBECONFIG": os.environ.get("KUBECONFIG", str(STATE / "kubeconfig"))}


def wallet_pvc_snapshot(strict=False):
    snapshot = {}
    for namespace, claim in (("lnd-testnet", "data-lnd-0-0"), ("lnd-regtest", "data-lnd-0-0"), ("lnd-regtest", "data-lnd-1-0")):
        try:
            result = subprocess.run(
                ["kubectl", "-n", namespace, "get", "pvc", claim, "--ignore-not-found", "-o", "jsonpath={.metadata.uid}"],
                text=True, capture_output=True, env=runtime_environment(), timeout=15,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            if strict:
                raise RuntimeError("wallet PVC 조회 실패; 최초 구축을 중단합니다") from exc
            return snapshot
        if strict and result.returncode:
            raise RuntimeError("wallet PVC 조회 실패; 최초 구축을 중단합니다")
        if result.returncode == 0 and result.stdout.strip():
            snapshot[f"{namespace}/{claim}"] = result.stdout.strip()
    return snapshot


def load_selection():
    if not SELECTION.exists():
        return None
    if SELECTION.is_symlink() or SELECTION.stat().st_uid != os.getuid() or SELECTION.stat().st_mode & 0o777 != 0o600:
        raise RuntimeError("unsafe wallet selection file")
    data = json.loads(SELECTION.read_text())
    if data.get("schema") != "lnd-ops/wallet-selection/v1" or data.get("choice") not in WALLET_CHOICES:
        raise RuntimeError("invalid wallet selection file")
    return data


def select_wallet(choice):
    title, mode, claims = WALLET_CHOICES[choice]
    snapshot = wallet_pvc_snapshot()
    if mode == "existing" and not all(claim in snapshot for claim in claims):
        raise RuntimeError(f"{title} PVC를 찾을 수 없습니다; 새 workspace를 선택하거나 지갑 상태를 확인하세요")
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    STATE.chmod(0o700)
    temporary = SELECTION.with_name(f".{SELECTION.name}.tmp-{os.getpid()}")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "w") as output:
        json.dump({"schema": "lnd-ops/wallet-selection/v1", "choice": choice, "pvc_uids": {claim: snapshot[claim] for claim in claims}}, output, sort_keys=True)
        output.write("\n")
    os.replace(temporary, SELECTION)
    SELECTION.chmod(0o600)
    print(f"선택됨: {title}")


def selection_gate():
    selected = load_selection()
    if selected is None:
        return "먼저 `wallet` 명령으로 기존 또는 새 wallet workspace를 선택하세요"
    title, mode, _ = WALLET_CHOICES[selected["choice"]]
    if mode == "new":
        return f"{title}는 별도 PVC/identity 생성 단계가 필요합니다. 기존 지갑은 변경하지 않습니다"
    current = wallet_pvc_snapshot()
    if any(current.get(claim) != uid for claim, uid in selected["pvc_uids"].items()):
        return f"선택한 {title} PVC identity가 바뀌었습니다; 실행을 중단합니다"
    return None


def prepare_new_workspace():
    """Provision a profile only after checking that its workspace is absent."""
    selected = load_selection()
    if not selected or WALLET_CHOICES[selected["choice"]][1] != "new":
        return 0
    profile = selected["choice"].removeprefix("new-")
    if pathlib.Path(runtime_environment()["KUBECONFIG"]) != STATE / "kubeconfig":
        print("STOP: 최초 구축에는 이 프로젝트의 기본 KUBECONFIG를 사용하세요.")
        return 10
    for command in (("ops/doctor",), ("ops/bootstrap",)):
        code = execute(command)
        if code:
            return code
    # A failed query is never evidence that a wallet does not exist.
    for resource in ("pvc", "statefulsets", "pods"):
        result = kubectl_json(["-n", f"lnd-{profile}", "get", resource])
        if not isinstance(result, dict) or not isinstance(result.get("items"), list):
            print("STOP: 기존 workspace 유무를 확인하지 못했습니다. 연결을 확인하고 재시도하세요.")
            return 10
        if result["items"]:
            print("STOP: 이 호스트에 해당 workspace가 이미 있습니다. wallet에서 기존 지갑을 선택하세요.")
            return 10
    code = execute(("ops/deploy", profile), fresh_profile=profile)
    if code:
        print("STOP: 최초 구축이 끝나지 않았습니다. PVC가 생성됐다면 wallet에서 기존 지갑을 선택해 이어가세요.")
        return code
    select_wallet(f"existing-{profile}")
    return 0


def prompt_wallet_selection():
    print("\n지갑 workspace 선택")
    for number, (choice, (title, mode, _)) in enumerate(WALLET_CHOICES.items(), 1):
        suffix = "기존 PVC를 고정" if mode == "existing" else "이 호스트에 해당 환경이 없을 때 최초 구축"
        print(f"[{number}] {title} — {suffix}")
    selected = load_selection()
    while True:
        try:
            answer = input("선택 [1-4]: ").strip()
        except EOFError:
            print()
            return False
        if not answer and selected:
            print(f"선택 유지: {WALLET_CHOICES[selected['choice']][0]}")
            return True
        if answer.isdigit() and 1 <= int(answer) <= len(WALLET_CHOICES):
            select_wallet(list(WALLET_CHOICES)[int(answer) - 1])
            return True
        print("1부터 4 또는 Enter를 입력하세요.", file=sys.stderr)


