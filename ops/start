def paint(text, color):
    return f"{color}{text}{RESET}" if sys.stdout.isatty() and "NO_COLOR" not in os.environ else text


def section(title, color=CYAN):
    print(paint("=" * 64, color))
    print(paint(f"  {title}", color))
    print(paint("=" * 64, color))


def status_label(state):
    labels = {
        "complete": ("OK", GREEN), "partial": ("PENDING", YELLOW),
        "manual": ("MANUAL", YELLOW), "missing": ("NOT BUILT", YELLOW),
        "failed": ("CHECK", RED),
    }
    label, color = labels.get(state, (state.upper(), RED))
    return paint(f"{label:9}", color)


def kubectl_json(arguments, timeout=20):
    try:
        result = subprocess.run(["kubectl", *arguments, "-o", "json"], text=True, capture_output=True, env=runtime_environment(), timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode:
        return None
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return None


def resource_count(namespace, resource, ready=False):
    data = kubectl_json(["-n", namespace, "get", resource])
    items = data.get("items", []) if data else []
    if not ready:
        if resource == "pvc":
            return sum(item.get("status", {}).get("phase") == "Bound" for item in items), len(items)
        return len(items), len(items)
    available = sum(
        all(status.get("ready") for status in item.get("status", {}).get("containerStatuses", []))
        for item in items
    )
    return available, len(items)


