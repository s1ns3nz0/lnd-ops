def operator_message(phase, detail):
    """Translate verifier output into the one action an operator needs now."""
    if phase["id"] == "testnet" and "unlock" in detail:
        return "기존 testnet 지갑이 잠겨 있습니다. 암호를 입력해 unlock합니다."
    if phase["id"] == "router":
        if "create or unlock" in detail:
            return "기존 testnet 지갑이 잠겨 있습니다. 암호를 입력해 unlock합니다."
        if "enable-router" in detail:
            return "공개 주소와 Lightning P2P 연결을 아직 구성하지 않았습니다."
        if "synchronization" in detail:
            return "testnet 체인과 그래프 동기화를 기다리고 있습니다."
        if "external URI" in detail:
            return "외부 TCP 9735 연결 또는 LND 공개 주소 확인이 필요합니다."
        if "second active public channel" in detail:
            return "routing 유동성이 있는 활성 공개 채널이 두 개 필요합니다."
        if "reviewed policy" in detail:
            return "두 공개 채널에 routing 수수료 정책을 적용할 차례입니다."
        if "separate external payer" in detail:
            return "외부 지갑이 이 노드를 경유한 작은 testnet 결제를 기다리고 있습니다."
    if detail == "이 단계는 사용자 확인이 필요합니다.":
        return "이 Phase의 운영 확인이 필요합니다."
    return detail.removeprefix("ACTION: ")


def router_active_public_channels():
    """Return the active public routing-channel count without changing LND state."""
    command = [
        "kubectl", "-n", "lnd-testnet", "exec", "lnd-0-0", "-c", "lnd", "--",
        "lncli", "--lnddir=/data/.lnd", "--network=testnet", "listchannels",
    ]
    try:
        result = subprocess.run(command, text=True, capture_output=True, env=runtime_environment(), timeout=30)
        if result.returncode:
            return None
        channels = json.loads(result.stdout).get("channels", [])
        return sum(
            channel.get("active") and not channel.get("private") and int(channel.get("local_balance", 0)) > 1
            for channel in channels
        )
    except (OSError, subprocess.SubprocessError, ValueError, json.JSONDecodeError):
        return None


def elapsed_time(seconds):
    minutes, seconds = divmod(max(0, int(seconds)), 60)
    hours, minutes = divmod(minutes, 60)
    return f"{hours:02}:{minutes:02}:{seconds:02}"


def render_router_wait(phase, active_channels, detail, channel_synced_at, started_at):
    channel_state = f"{active_channels}/2" if active_channels is not None else "확인 중/2"
    synced = time.strftime("%H:%M:%S", time.localtime(channel_synced_at)) if channel_synced_at else "대기 중"
    message = operator_message(phase, detail)
    line = (
        f"  Router · 공개 채널 {channel_state} · 대기: {message} · "
        f"최근 채널 동기화: {synced} · 경과: {elapsed_time(time.monotonic() - started_at)}"
    )
    if sys.stdout.isatty():
        sys.stdout.write(f"\r\033[2K{line}")
        sys.stdout.flush()
    else:
        print(line)


def guide_router(number, phase):
    section("PHASE 03 · ROUTER PROGRESS", CYAN)
    started_at = time.monotonic()
    previous = None
    previous_channels = None
    channel_synced_at = None
    while True:
        state, detail = inspect(number - 1)
        active_channels = router_active_public_channels()
        if active_channels != previous_channels:
            previous_channels = active_channels
            channel_synced_at = time.time()
        if state == "complete":
            if sys.stdout.isatty():
                print()
            print("  완료: 공개 Router 조건과 실제 forwarding이 검증되었습니다.")
            return state
        if state == "failed":
            if sys.stdout.isatty():
                print()
            print(f"  확인 오류: {operator_message(phase, detail)}")
            return state
        if "create or unlock" in detail:
            print("  다음 작업: 기존 testnet 지갑을 unlock합니다.")
            if not run_testnet_unlock():
                print("  unlock이 완료되지 않았습니다. 암호를 다시 입력해 재시도합니다.")
            continue
        if "run ops/enable-router" in detail:
            print("  다음 작업: 공개 P2P 연결을 자동 구성합니다.")
            if not run_router_wizard():
                print("  공개 P2P 연결을 아직 구성하지 않았습니다. 필요한 주소를 입력하면 다시 시도합니다.")
            continue
        if "reviewed policy" in detail:
            try:
                answer = input("  routing 수수료 정책 적용 [Enter=적용]: ").strip().lower()
            except EOFError:
                return "partial"
            if answer:
                print("  정책을 적용하지 않았습니다. 10초 뒤 현재 조건을 다시 확인합니다.")
                time.sleep(ROUTER_POLL_SECONDS)
            else:
                result = subprocess.run([str(REPO / "ops/configure-router-policy"), "--confirm", "APPLY ROUTER POLICY"], cwd=REPO, env=runtime_environment(), text=True, capture_output=True)
                print("  완료: routing 수수료 정책을 적용했습니다." if result.returncode == 0 else "  보류: 채널 정책을 아직 적용할 수 없습니다.")
            continue
        current = (state, detail)
        if current != previous:
            if previous is not None:
                if sys.stdout.isatty():
                    print()
                print(f"  상태 변경: {operator_message(phase, detail)}")
            previous = current
        render_router_wait(phase, active_channels, detail, channel_synced_at, started_at)
        try:
            time.sleep(ROUTER_POLL_SECONDS)
        except KeyboardInterrupt:
            if sys.stdout.isatty():
                print()
            print("\n  Router 검증을 중단했습니다. 다시 Phase 3을 선택하면 이어서 확인합니다.")
            return "partial"


def run_confirmed(label, command, confirmation="Enter=실행"):
    """Run one named operator action without exposing its command syntax in the UI."""
    try:
        answer = input(f"  {label} [{confirmation}, s=건너뜀]: ").strip()
    except EOFError:
        return False
    if answer.lower() == "s":
        print("  건너뛰었습니다. 현재 Phase 화면에서 상태를 계속 확인합니다.")
        return False
    if confirmation.startswith("TYPE ") and answer != confirmation.removeprefix("TYPE "):
        print("  확인 문구가 일치하지 않아 실행하지 않았습니다.")
        return False
    result = subprocess.run([str(REPO / command[0]), *command[1:]], cwd=REPO, env=runtime_environment())
    if result.returncode == 0:
        print(f"  완료: {label}")
        return True
    print(f"  보류: {label}이 완료되지 않았습니다. 상태를 다시 확인합니다.")
    return False


def wait_for_phase(number, phase, detail, attempts):
    print(f"  확인 {attempts:02}: {operator_message(phase, detail)}")
    print(f"  {ROUTER_POLL_SECONDS}초 뒤 상태를 다시 확인합니다. 완료 전까지 이 화면을 유지합니다.")
    try:
        time.sleep(ROUTER_POLL_SECONDS)
