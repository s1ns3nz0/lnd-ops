    print("[0] 현재 상태와 다음 완료 Phase를 조회합니다.")
    print("[1-11] 선택한 번호까지 안전한 인프라를 자동 구축합니다. 수동 실습은 PENDING으로 남습니다.")
    for number, phase in enumerate(PHASES, 1):
        print(paint(f"\n[{number}] {phase['title']}", YELLOW))
        print(f"  {phase['environment']}")
    print_commands()


def print_commands():
    section("COMMANDS", CYAN)
    print("  0          현재 resource·Phase 상태와 다음 수행 Phase 조회")
    print("  1-11       선택한 번호까지 안전한 인프라 자동 구축")
    print("  wallet     기존 또는 새 wallet workspace 선택")
    print("  status     모든 Phase의 현재 상태만 확인")
    print("  delete     삭제할 project resource를 직접 선택")
    print("  help 또는 ?  이 명령 목록 다시 보기")
    print("  quit 또는 exit  종료")


def print_catalog():
    print(BANNER)
    print_wallet_overview()
    print_phase_catalog()


def print_status():
    section("CURRENT RESOURCES", GREEN)
    namespaces = tuple(dict.fromkeys(namespace for phase in PHASES for namespace in phase["namespaces"]))
    for namespace in namespaces:
        result = subprocess.run(["kubectl", "get", "namespace", namespace, "-o", "jsonpath={.status.phase}"], text=True, capture_output=True, env=runtime_environment(), timeout=15)
        if result.returncode:
            print(paint(f"  ○ {namespace:<20} ABSENT", YELLOW))
            continue
        workloads = sum(resource_count(namespace, resource)[1] for resource in ("statefulsets", "deployments", "daemonsets"))
        pods_ready, pods_total = resource_count(namespace, "pods", ready=True)
        pvcs_bound, pvcs_total = resource_count(namespace, "pvc")
        _, services = resource_count(namespace, "services")
        print(paint(f"  ● {namespace:<20} {result.stdout.strip():<8}", GREEN))
        print(f"    workloads {workloads:<2}  pods {pods_ready}/{pods_total} Ready  storage {pvcs_bound}/{pvcs_total} Bound  services {services}")
    section("PHASE STATUS", CYAN)
    print("  OK       자동 구축과 검증이 모두 완료됨")
    print("  PENDING  인프라는 있으나 지갑·채널·외부 연결 같은 조건이 남음")
    print("  CHECK    예상하지 못한 검증 오류가 있어 상태 확인이 필요함")
    print("  MANUAL   자동 구축 대상이 아닌 운영 실습 또는 증거 단계")
    print()
    next_phase = None
    for number, phase in enumerate(PHASES, 1):
        state, detail = inspect(number - 1)
        print(f"  {number:02}  {status_label(state)}  {phase['title']}")
        if next_phase is None and state != "complete":
            next_phase = (number, phase, detail)
    if next_phase:
        number, phase, detail = next_phase
        section("NEXT COMPLETION", YELLOW)
        print(f"  Phase {number:02} · {phase['title']}")
        print(f"  상태: {detail}")
        if applies_to_selected_workspace(phase):
            for index, step in enumerate(manual_steps(phase), 1):
                print(f"  {index}. {step}")
        else:
            print("  이 수동 실습은 현재 선택한 wallet workspace와 무관하므로 자동 구축만 유지합니다.")
    else:
        print("NEXT: 모든 Phase가 완료되었습니다.")


def build_through(target, dry_run=False, interactive=False):
    if target == 0:
        print_status()
        return 0
    print(f"\nPhase 1 → {target} 자동 구축")
    print(f"KUBECONFIG: {runtime_environment()['KUBECONFIG']}")
    if not dry_run:
        gate = selection_gate()
        if gate:
            print(f"STOP: {gate}")
            return 10
    pending = False
    for index, phase in enumerate(PHASES[:target]):
        number = index + 1
        phase_pending = False
        state, detail = inspect(index) if not dry_run else ("missing", "dry-run")
        if state == "complete":
            print(f"[{number}] SKIP {phase['title']} — already complete")
            continue
        if state == "partial":
            pending = True
            phase_pending = True
            print(f"[{number}] PENDING {phase['title']} — {detail}")
            if dry_run or applies_to_selected_workspace(phase):
                guide_operator(number, phase, detail, interactive)
            else:
                print("  현재 선택한 wallet workspace와 무관한 수동 실습은 건너뜁니다.")
            continue
        if state == "failed":
            print(f"[{number}] STOP {phase['title']} — {detail}", file=sys.stderr)
            print("ACTION: fix the reported verifier error, then rerun this selection.", file=sys.stderr)
            return 1
        if not phase["build"]:
            pending = True
            print(f"[{number}] PENDING {phase['title']} — manual phase")
            if dry_run or applies_to_selected_workspace(phase):
                guide_operator(number, phase, "이 단계는 사용자 확인이 필요합니다.", interactive)
            else:
                print("  현재 선택한 wallet workspace와 무관한 수동 실습은 건너뜁니다.")
            continue
        print(f"[{number}] BUILD {phase['title']} — {detail}")
        for command in phase["build"]:
            code = execute(command, dry_run)
            if code:
                if code == 10:
                    pending = True
                    phase_pending = True
                    if applies_to_selected_workspace(phase):
                        guide_operator(number, phase, "자동 구성은 끝났고 사용자 확인이 필요합니다.", interactive)
                    break
                else:
                    print(f"FAIL: {display(command)} exited {code}", file=sys.stderr)
                    return code
        if phase.get("post_verify", True) and not dry_run:
            verified, verified_detail = inspect(number)
            if verified != "complete":
                if verified == "partial":
                    pending = True
                    phase_pending = True
                    print(f"[{number}] PENDING {phase['title']} — post-build verification: {verified_detail}")
                    if applies_to_selected_workspace(phase):
                        guide_operator(number, phase, verified_detail, interactive)
                else:
                    print(f"[{number}] STOP {phase['title']} — post-build verification: {verified_detail}", file=sys.stderr)
                    return 1
        if phase_pending:
            print(f"[{number}] PENDING {phase['title']} — automatic build completed; manual gate remains")
        else:
            print(f"[{number}] {'PLANNED' if dry_run else 'DONE'} {phase['title']}")
    if pending:
        print(f"PENDING: Phase {target}까지 인프라는 자동 구축했고, 위 수동 실습 gate가 남아 있습니다.")
        return 0 if dry_run else 10
    print(f"DONE: Phase {target}까지의 자동 구성이 끝났습니다.")
    return 0


def repl():
    print(BANNER)
    section("WALLET WORKSPACE", GREEN)
    if not prompt_wallet_selection():
        return 0
    print_wallet_overview()
    print_phase_catalog()
    while True:
        try:
            answer = input("lnd-ops> ").strip().lower()
        except EOFError:
            print()
            return 0
        if answer in ("quit", "exit"):
            return 0
        if answer in ("help", "?"):
            print_commands()
        elif answer == "wallet":
            prompt_wallet_selection()
        elif answer == "delete":
            print("삭제 선택: testnet, regtest, monitoring, kyverno, falco, kagent, agent")
            selected = ",".join(item.strip() for item in input("쉼표로 입력 (빈 입력은 취소): ").split(",") if item.strip())
            if selected:
                options = [str(REPO / "ops/purge-project"), "--select", selected]
                profiles = {"testnet", "regtest"} & set(selected.split(","))
                if profiles and input("선택한 profile의 지갑 PVC도 삭제합니까? [y/N]: ").strip().lower() in ("y", "yes"):
                    options.append("--delete-wallet-data")
                preview = subprocess.run([*options, "--dry-run"], cwd=REPO)
                if preview.returncode:
                    continue
                phrase = "DELETE " + selected + (",wallet-data" if "--delete-wallet-data" in options else "")
                confirm = input(f"실행하려면 정확히 입력: {phrase}\n> ").strip()
                if confirm == phrase:
                    subprocess.run([*options, "--confirm", confirm], cwd=REPO)
        elif answer in ("0", "status"):
            print_status()
        elif answer.isdigit() and 1 <= int(answer) <= len(PHASES):
            build_through(int(answer), interactive=True)
        elif answer:
            print("0부터 11, status, help, quit 중 하나를 입력하세요.", file=sys.stderr)


def parse_args(arguments):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--list", action="store_true", help="show the phase catalog and exit")
    parser.add_argument("--status", action="store_true", help="inspect every phase and exit")
    parser.add_argument("--to", type=int, choices=range(len(PHASES) + 1), metavar="N", help="show status at 0 or build cumulatively through phase N")
    parser.add_argument("--dry-run", action="store_true", help="show the cumulative build plan without executing it")
    parser.add_argument("--select", choices=WALLET_CHOICES, help="persist a wallet workspace selection")
    return parser.parse_args(arguments)


def main(arguments):
    args = parse_args(arguments)
    if args.select:
        select_wallet(args.select)
        return 0
    if args.list:
        print_catalog()
        return 0
    if args.status:
        print_status()
        return 0
    if args.to is not None:
        return build_through(args.to, args.dry_run)
    if not sys.stdin.isatty():
        print("interactive input unavailable; use --list, --status, or --to 0..11", file=sys.stderr)
        return 2
    return repl()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
