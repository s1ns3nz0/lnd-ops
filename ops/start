def router_forwarding_rows(snapshot, fresh, limit=2):
    label = '최근 24시간 중계' if fresh else '이전 조회 중계 · 재조회 필요'
    count = snapshot.get('forwarding_history_count')
    if count is None:
        return ['  == 중계 기록 ==', '  아직 조회하지 못했습니다 · 0건으로 판단하지 않습니다.']
    fee = snapshot.get('forwarding_history_fee_msat', 0)
    partial = ' · 일부 기록(조회 상한 도달)' if snapshot.get('forwarding_window_capped') else ''
    rows = [f'  == {label} · {ROUTER_POLL_SECONDS}초마다 조회 ==',
            f'  {count:,}건 / 수수료 {fee / 1000:,.3f} sat' + partial + f' · 최근 {min(count, limit)}건 표시']
    for event in snapshot.get('forwarding_recent', [])[:limit]:
        def peer(direction):
            value = event.get(direction + '_peer')
            return value[:10] + '…' if value else '채널 ' + event[direction + '_channel']
        stamp = time.strftime('%m-%d %H:%M:%S', time.localtime(event['timestamp']))
        rows += [f"  {stamp} · 출금 {event['amount_msat'] / 1000:,.3f} sat · 수수료 {event['fee_msat'] / 1000:,.3f} sat",
                 f"    {peer('incoming')} → 이 노드 → {peer('outgoing')}"]
    if count == 0:
        rows.append('  조회한 24시간 중계 없음 · 송신/수신 결제는 별도')
    return rows


def render_router_snapshot(snapshot, changed_at, last_success, started_at, previous_lines, *, compact=False):
    now = time.time()
    fresh = last_success is not None and 0 <= now - last_success <= 30 and snapshot.get('code') != 'query_error'
    external = fresh and snapshot.get('external_reachability') == 'operator_attested' and snapshot.get('external_expires_at', 0) > now
    clock = f"  경과 시간  {elapsed_time(time.monotonic() - started_at)}"
    if snapshot.get('code') == 'loading':
        rows = ['  [조회 중] 노드 상태를 가져오고 있습니다.', clock]
        if sys.stdout.isatty():
            rows.append(ROUTER_INPUT_PROMPT)
        return render_router_lines(rows, previous_lines)
    ready = '조회 실패' if snapshot.get('code') == 'query_error' else '새 조회 필요' if not fresh else '준비 완료' if snapshot.get('ready') else '조건 확인 중'
    proof = snapshot.get('forwarding_proof')
    forwarded = proof in ('observed', 'verified')
    routing = '로컬 중계 관측' if proof == 'observed' else '실경유 이력 확인' if forwarded else '트래픽 대기' if snapshot.get('ready') else '미검증'
    rows = router_progress_summary(snapshot, fresh, external) + [
        '  == 운영 상태 ==',
        f"  [{'완료' if fresh and snapshot.get('ready') else '확인'}] 라우팅 준비: {ready}",
        f"  [{'관측' if forwarded else '대기'}] 실제 중계: {routing}",
        f"  [{'확인' if external else '미검증'}] 외부 접속: {'운영자 외부 검사' if external else '별도 검사 필요'}",
    ]
    if forwarded and snapshot.get('proof_verified_at'):
        rows.append('  중계 시각: ' + time.strftime('%m-%d %H:%M:%S', time.localtime(snapshot['proof_verified_at'])))
    if external:
        rows.append('  외부 검사 유효: ' + time.strftime('%H:%M:%S', time.localtime(snapshot['external_expires_at'])) + '까지')
    rows += ['  == 채널 · 동기화 ==',
             f"  연결된 활성 공개 {snapshot.get('active_public', '?')}/2개 / 상대 노드 {snapshot.get('public_peers', '?')}개",
             f"  대기 {snapshot.get('pending_public', '?')} / 비활성 {snapshot.get('inactive_public', '?')} / 비공개 {snapshot.get('private', '?')}",
             f"  체인 {'완료' if snapshot.get('synced_to_chain') else '확인 중'} / 그래프 {'완료' if snapshot.get('synced_to_graph') else '확인 중'}"]
    for channel in snapshot.get('channels', []):
        peer = channel.get('peer') or '미확인'
        label = peer[:12] + '…' + peer[-8:] if len(peer) > 24 else peer
        state = ('활성' if channel.get('active') else '비활성') if fresh else '이전 조회'
        connection = ('연결됨' if channel.get('peer_connected') else '연결 끊김') if fresh and 'peer_connected' in channel else '연결 미확인'
        kind = '비공개' if channel.get('private') else '공개'
        rows.append(f'  {kind} · 채널 {state} · 상대 {label} · {connection}')
        rows.append(f"    보낼 수 있음 {channel.get('outbound_msat', 0) / 1000:,.3f} sat / 받을 수 있음 {channel.get('inbound_msat', 0) / 1000:,.3f} sat")
    if snapshot.get('pending_public') or snapshot.get('code') in ('funding_pending', 'funding_review'):
        rows += [f"  채널 확인: {snapshot.get('funding_progress', '조회 중')}",
                 f"  만료 조건: {snapshot.get('funding_expiry', '조회 중')}"]
    rows += ['  == 현재 안내 ==']
    funding = snapshot.get('funding', [])
    if funding:
        rows.append('  [개설 접수됨] 블록 확인·채널 활성화 대기' if fresh else
                    '  [이전 조회] 개설 대기 채널 · 현재 상태 재조회 필요')
        for item in funding:
            peer = item.get('peer') or '미제공'
            peer_label = peer[:12] + '…' + peer[-8:] if len(peer) > 24 else peer
            connected = ('연결됨' if item.get('peer_connected') else '연결 끊김') if fresh else '현재 연결 미확인'
