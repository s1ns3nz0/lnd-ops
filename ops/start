def print_catalog():
    print(BANNER)
    print_wallet_overview()
    print_phase_catalog()


def print_status():
    print("\n현재 환경")
    for number, phase in enumerate(PHASES):
        state, detail = inspect(number)
        print(f"[{number}] {state:8} {phase['title']} — {detail}")


def build_through(target, dry_run=False):
    print(f"\nPhase 0 → {target} 확인 및 구성")
    print(f"KUBECONFIG: {runtime_environment()['KUBECONFIG']}")
    if not dry_run:
        gate = selection_gate()
        if gate:
            print(f"STOP: {gate}")
            return 10
    for number, phase in enumerate(PHASES[:target + 1]):
        state, detail = inspect(number) if not dry_run else ("missing", "dry-run")
        if state == "complete":
            print(f"[{number}] SKIP {phase['title']} — already complete")
            continue
        if state == "partial":
            print(f"[{number}] STOP {phase['title']} — {detail}")
            print(f"ACTION: {phase['manual']}")
            return 0 if dry_run else 10
        if state == "failed":
            print(f"[{number}] STOP {phase['title']} — {detail}", file=sys.stderr)
            print("ACTION: fix the reported verifier error, then rerun this selection.", file=sys.stderr)
            return 1
        if not phase["build"]:
            print(f"[{number}] STOP {phase['title']} — manual phase")
            print(f"ACTION: {phase['manual']}")
            return 0 if dry_run else 10
        print(f"[{number}] BUILD {phase['title']} — {detail}")
        for command in phase["build"]:
            code = execute(command, dry_run)
            if code:
                if code == 10:
                    print(f"ACTION: {phase['manual']}")
                else:
                    print(f"FAIL: {display(command)} exited {code}", file=sys.stderr)
                return code
        if phase.get("post_verify", True) and not dry_run:
            verified, verified_detail = inspect(number)
            if verified != "complete":
                print(f"[{number}] STOP {phase['title']} — post-build verification: {verified_detail}", file=sys.stderr)
                print(f"ACTION: {phase['manual']}", file=sys.stderr)
                return 10 if verified == "partial" else 1
        print(f"[{number}] {'PLANNED' if dry_run else 'DONE'} {phase['title']}")
    print(f"DONE: Phase {target}까지의 자동 구성이 끝났습니다.")
    return 0


def repl():
    print(BANNER)
    if load_selection() is None:
        section("WALLET WORKSPACE", GREEN)
        if not prompt_wallet_selection():
            return 0
    print_wallet_overview()
    print_phase_catalog()
    while True:
        try:
            answer = input("lnd-ops> ").strip().lower()
        except EOFError:
            print()
            return 0
        if answer in ("quit", "exit"):
            return 0
        if answer in ("help", "?"):
            print("0-9: 누적 구성 | wallet: workspace 변경 | delete: 선택형 삭제 메뉴 | status | quit")
        elif answer == "wallet":
            prompt_wallet_selection()
        elif answer == "delete":
            print("삭제 선택: testnet, regtest, monitoring, kyverno, falco, kagent, agent")
            selected = input("쉼표로 입력 (빈 입력은 취소): ").strip()
            if selected:
                subprocess.run([str(REPO / "ops/purge-project"), "--select", selected, "--dry-run"], cwd=REPO)
                phrase = "DELETE " + selected
                confirm = input(f"실행하려면 정확히 입력: {phrase}\n> ").strip()
                if confirm == phrase:
                    subprocess.run([str(REPO / "ops/purge-project"), "--select", selected, "--confirm", confirm], cwd=REPO)
        elif answer == "status":
            print_status()
        elif answer.isdigit() and 0 <= int(answer) < len(PHASES):
            build_through(int(answer))
        elif answer:
            print("0부터 9, status, help, quit 중 하나를 입력하세요.", file=sys.stderr)


def parse_args(arguments):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--list", action="store_true", help="show the phase catalog and exit")
    parser.add_argument("--status", action="store_true", help="inspect every phase and exit")
    parser.add_argument("--to", type=int, choices=range(len(PHASES)), metavar="N", help="build cumulatively through phase N")
    parser.add_argument("--dry-run", action="store_true", help="show the cumulative build plan without executing it")
    parser.add_argument("--select", choices=WALLET_CHOICES, help="persist a wallet workspace selection")
    return parser.parse_args(arguments)


def main(arguments):
    args = parse_args(arguments)
    if args.select:
        select_wallet(args.select)
        return 0
    if args.list:
        print_catalog()
        return 0
    if args.status:
        print_status()
        return 0
    if args.to is not None:
        return build_through(args.to, args.dry_run)
    if not sys.stdin.isatty():
        print("interactive input unavailable; use --list, --status, or --to 0..9", file=sys.stderr)
        return 2
    return repl()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
