        f"  대기 조건       {router_wait_message(phase, detail)}",
        f"  최근 채널 동기화 {synced}",
        f"  경과 시간       {elapsed_time(time.monotonic() - started_at)}",
    )
    return render_router_lines(raw_lines, previous_lines)


ROUTER_INPUT_PROMPT = "  입력 > "


def render_router_lines(raw_lines, previous_lines=None):
    columns = shutil.get_terminal_size((80, 24)).columns
    lines = tuple(fit_terminal_line(line, columns) for line in raw_lines)
    def styled(line):
        color = CYAN if '==' in line else GREEN if '[완료]' in line or '[관측]' in line or '[확인] 외부' in line else YELLOW if '[' in line else None
        return paint(line, color) if color else line
    if sys.stdout.isatty():
        height = shutil.get_terminal_size((80, 24)).lines
        if len(lines) > height or (previous_lines and len(previous_lines) > height):
            # Cursor-up cannot reach rows already scrolled out of the viewport.
            # For a small window, append status changes and suppress timer ticks.
            def content(block):
                return tuple(row for row in block if row != ROUTER_INPUT_PROMPT
                             and '경과 시간' not in row and '최근 조회:' not in row)
            if previous_lines is None or content(lines) != content(previous_lines):
                sys.stdout.write(('\n' if previous_lines else '') + '\n'.join(styled(row) for row in lines))
                sys.stdout.flush()
            return lines
        if previous_lines and previous_lines[-1] == lines[-1] == ROUTER_INPUT_PROMPT:
            # Canonical terminal input owns the last row. Keep its text and
            # cursor intact while updating only the dashboard above it.
            delta = len(lines) - len(previous_lines)
            sys.stdout.write('\0337')
            if delta:
                sys.stdout.write(f'\033[{len(previous_lines) - 1}A\r')
                sys.stdout.write(f'\033[{abs(delta)}{"L" if delta > 0 else "M"}')
                sys.stdout.write('\0338')
                sys.stdout.write(f'\033[{abs(delta)}{"B" if delta > 0 else "A"}')
                sys.stdout.write('\0337')
            for index, current in enumerate(lines[:-1]):
                if not delta and previous_lines[index] == current:
                    continue
                sys.stdout.write(f'\033[{len(lines) - 1 - index}A\r\033[2K{styled(current)}\0338')
            sys.stdout.flush()
            return lines
        if previous_lines is not None and len(previous_lines) != len(lines):
            if len(previous_lines) > 1:
                sys.stdout.write(f"\033[{len(previous_lines) - 1}A")
            sys.stdout.write('\r\033[J')
            previous_lines = None
        if previous_lines is None:
            sys.stdout.write("\n".join(styled(line) for line in lines))
        else:
            last_index = len(lines) - 1
            for index, (previous, current) in enumerate(zip(previous_lines, lines)):
                if previous == current:
                    continue
                upward = last_index - index
                if upward:
                    sys.stdout.write(f"\033[{upward}A")
                sys.stdout.write(f"\r\033[2K{styled(current)}")
                if upward:
                    sys.stdout.write(f"\033[{upward}B")
                sys.stdout.write("\r")
        sys.stdout.flush()
    elif previous_lines is None or len(previous_lines) != len(lines):
        print("\n".join(lines))
    else:
        changed = [current for previous, current in zip(previous_lines[:-1], lines[:-1]) if previous != current]
        if changed:
            print("\n".join(changed))
    return lines


def router_progress_summary(snapshot, fresh, external):
    """Explain independent milestones using only evidence from this snapshot."""
    code = snapshot.get('code')
    synced = snapshot.get('synced_to_chain') and snapshot.get('synced_to_graph')
    channels_ready = snapshot.get('public_peers', 0) >= 2
    ready = snapshot.get('ready', False)
    forwarded = snapshot.get('forwarding_proof') in ('observed', 'verified')
    def mark(done, waiting='미검증'):
        return '새 조회 필요' if not fresh else '완료' if done else waiting
    rows = ['  == 라우팅 실습 진행 상황 ==',
            '  조회 대상: testnet 노드 ' + str(snapshot.get('identity') or '확인 불가'),
            f"  1. 체인·그래프 동기화 [{mark(synced, '진행 중' if code == 'syncing' else '미검증')}]",
            f"  2. 서로 다른 상대와 공개 채널 2개 [{mark(channels_ready, '개설 확인 대기' if snapshot.get('pending_public') else '조건 미충족')}]",
            f"  3. 수수료 정책·전달 가능 잔액 [{mark(ready, '조건 미충족' if code in ('policy_required', 'liquidity_required') else '미검증')}]",
            f"  4. 실제 결제 중계 이력 [{mark(forwarded, '트래픽 대기' if ready else '미검증')}]",
            f"  5. 외부망에서 P2P 접속 확인 [{mark(external)}]"]
    if not fresh:
        rows += ['  현재 위치: 최신 상태를 확인하지 못했습니다.', '  다음 행동: r로 재조회 · 아래 이전 조회값으로 작업하지 마세요.']
    else:
        guidance = {
            'funding_pending': ('공개 채널 개설 요청 접수 · 블록 확인/활성화 대기', '자동 조회를 기다리세요. 같은 채널을 다시 개설할 필요 없습니다.'),
            'funding_review': ('개설 대기 채널의 만료 조건 확인 필요', '상대 노드와 funding 거래 상태를 확인하세요.'),
            'proof_required': ('라우팅 준비 완료 · 실제 중계 이력은 아직 없음', '실제 결제가 이 노드를 통과해야 합니다. 자동 발생 시점은 알 수 없습니다.'),
            'external_required': ('실제 중계 확인 · 외부 접속 검사 남음', 'e로 외부망 검사 요청/결과를 확인하세요.'),
            'complete': ('모든 검증 조건 충족', '현재 중계와 채널 상태를 유지·관측하세요.'),
            'channel_required': ('서로 다른 상대의 활성 공개 채널 부족', 'a로 채널 개설 안내를 여세요.'),
            'peer_disconnected': ('상대 연결 확인 필요', '상대 노드와 네트워크 연결을 확인하세요.'),
            'syncing': ('체인·그래프 동기화 중', '동기화 완료를 기다리세요.'),
            'graph_pending': ('채널 정책 정보 수신 대기', '자동 재조회를 기다리세요.'),
