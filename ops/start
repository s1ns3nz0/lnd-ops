def regtest_wallet_state(node, network="regtest"):
    result = subprocess.run(
        ["kubectl", "-n", f"lnd-{network}", "exec", f"{node}-0", "-c", "lnd", "--", "lncli", "--lnddir=/data/.lnd", f"--network={network}", "state"],
        text=True, capture_output=True, env=runtime_environment(), timeout=60,
    )
    if result.returncode:
        return "UNKNOWN"
    try:
        return json.loads(result.stdout).get("state", "UNKNOWN")
    except json.JSONDecodeError:
        return "UNKNOWN"


