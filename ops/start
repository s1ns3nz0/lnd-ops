# `ops/start` is an ordinary, wallet-preserving setup path. Destructive reset,
# wallet-creation, funding, recovery, and fault-exercise commands are never
# eligible for automatic execution here.
SAFE_AUTOMATIC_COMMANDS = frozenset({
    ("ops/doctor",),
    ("ops/bootstrap",),
    ("ops/deploy", "regtest"),
    ("ops/verify", "regtest"),
    ("ops/deploy", "testnet"),
