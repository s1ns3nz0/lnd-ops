#!/usr/bin/env python3
"""Delete only operator-selected lnd-ops namespaces; never delete K3s itself."""
import argparse, os, pathlib, subprocess, sys

STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state")) / "lnd-ops"
ITEMS = {
    "testnet": ("lnd-testnet",), "regtest": ("lnd-regtest", "lnd-regtest-recovery"),
    "monitoring": ("lnd-monitoring",), "kyverno": ("kyverno",), "falco": ("falco",),
    "kagent": ("kagent",), "agent": ("lnd-agent",),
}

def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--select", required=True, help="comma-separated: " + ", ".join(ITEMS))
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--confirm", metavar="TEXT")
    args = parser.parse_args(argv)
    selected = tuple(item for item in args.select.split(",") if item)
    if not selected or len(set(selected)) != len(selected) or any(item not in ITEMS for item in selected):
        parser.error("--select must contain unique known items")
    phrase = "DELETE " + ",".join(selected)
    namespaces = tuple(namespace for item in selected for namespace in ITEMS[item])
    print("Selected: " + ", ".join(selected))
    print("Namespaces/PVCs to delete: " + ", ".join(namespaces))
    print("K3s, host backups, seeds, SSH keys, and global Docker cache are excluded.")
    if args.dry_run: return 0
    if args.confirm != phrase:
        print("ACTION: rerun with --confirm " + repr(phrase), file=sys.stderr); return 2
    env = os.environ | {"KUBECONFIG": os.environ.get("KUBECONFIG", str(STATE / "kubeconfig"))}
    for namespace in namespaces:
        check = subprocess.run(["kubectl", "get", "namespace", namespace], env=env, capture_output=True)
        if check.returncode == 0:
            subprocess.run(["kubectl", "delete", "namespace", namespace, "--wait=true"], env=env, check=True)
    return 0
if __name__ == "__main__": sys.exit(main(sys.argv[1:]))
