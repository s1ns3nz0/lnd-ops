#!/usr/bin/env python3
"""Read-only Router readiness and completion status, in text or JSON."""
import argparse
import json
import subprocess
import sys
import time

from router_model import assess, channel_id
from router_rpc import call, environment, WalletLocked, GraphEdgeMissing
from router_proof import current_evidence
from router_store import read, state_directory
from router_policy import target
from router_observation import current as current_observation


def validate_p2p_service(service):
    """Check the chart's P2P-only NodePort 30973 contract, not reachability."""
    spec = service['spec']
    if spec.get('type') != 'NodePort':
        raise ValueError('Router P2P 서비스 유형이 NodePort가 아닙니다')
    if spec.get('selector') != {'app.kubernetes.io/name': 'lnd-0'}:
        raise ValueError('Router P2P 서비스 대상이 testnet 첫 LND 노드와 다릅니다')
    ports = spec['ports']
    if len(ports) != 1:
        raise ValueError('Router P2P 서비스에는 TCP 9735 포트 하나만 허용됩니다')
    port = ports[0]
    if (port.get('port') != 9735 or port.get('nodePort') != 30973
            or port.get('targetPort', port.get('port')) != 9735
            or port.get('protocol', 'TCP') != 'TCP'):
        raise ValueError('Router P2P 서비스는 TCP 9735 → LND 9735 / NodePort 30973이어야 합니다')


def readiness(test_sat=10, fee_limit_sat=10, rpc=call, info=None):
    info = rpc("getinfo") if info is None else info
    desired_policy = target(state_directory(), info.get("identity_pubkey"))
    channels = rpc("listchannels").get("channels", [])
    pending = rpc("pendingchannels")
    peers = rpc("listpeers").get("peers", [])
    early = assess(info, channels, pending, peers, {}, test_sat=test_sat, fee_limit_sat=fee_limit_sat, target_policy=desired_policy)
    if early["code"] not in ("policy_required", "graph_pending"):
        return early
    policies = {}
    for channel in channels:
        if channel.get("private") or not channel.get("active"):
            continue
        try:
            graph = rpc("getchaninfo", f"--chan_id={channel_id(channel)}")
        except GraphEdgeMissing:
            # Retain live channel counts. Missing graph data is not permission
            # to reapply policy, open another channel, or advance the phase.
            continue
        if graph.get("node1_pub") == info["identity_pubkey"]:
            own, remote = "node1_policy", "node2_policy"
        elif graph.get("node2_pub") == info["identity_pubkey"]:
            own, remote = "node2_policy", "node1_policy"
        else:
            raise ValueError("channel graph does not contain the current identity")
        policies[channel_id(channel)] = {"own": graph.get(own), "remote": graph.get(remote)}
    return assess(info, channels, pending, peers, policies, test_sat=test_sat, fee_limit_sat=fee_limit_sat, target_policy=desired_policy)


def snapshot(test_sat=10, fee_limit_sat=10):
    base = {"schema": "lnd-ops/router-status/v1", "ready": False, "complete": False,
            "external_reachability": "unverified", "forwarding_proof": "unverified"}
    try:
        service = subprocess.run(
            ["kubectl", "-n", "lnd-testnet", "get", "service", "lnd-router-p2p", "--ignore-not-found", "-o", "json"],
            env=environment(), text=True, capture_output=True, timeout=15,
        )
        if service.returncode:
            raise RuntimeError((service.stderr or service.stdout).strip() or "Kubernetes 조회 실패")
        if not service.stdout.strip():
            result = base | {"code": "exposure_required", "message": "공개 P2P 연결 구성이 필요합니다"}
        else:
            validate_p2p_service(json.loads(service.stdout))
            info = call("getinfo")
            result = base | readiness(test_sat, fee_limit_sat, info=info)
            proof = read(state_directory(), "forwarding-proof.json")
            if current_evidence(proof, result.get("identity"), result.get("channels", [])):
                result.update(forwarding_proof="verified", proof_verified_at=proof["verified_at"])
            observation = read(state_directory(), "p2p-observation.json")
            if current_observation(observation, info):
                result.update(external_reachability="operator_attested",
                              external_verified_at=observation["observation"]["verified_at"],
                              external_expires_at=observation["observation"]["request"]["expires_at"],
                              external_provenance="operator-controlled-unsigned")
            if result["ready"]:
                # Historical fwdinghistory events and an advertised URI alone
                # are not evidence of a current end-to-end verification.
                result.update(code="proof_required", message="라우팅 준비 완료 / 외부 접속·실경유 검증 필요")
                if result["forwarding_proof"] == "verified":
                    result.update(code="external_required", message="실경유 검증 완료 / 외부 P2P 접속 검증 필요")
                    if result["external_reachability"] == "operator_attested":
                        result.update(complete=True, code="complete",
                                      message="현재 라우팅 준비·실경유 이력 확인 / 외부 접속은 운영자 실행 결과로 확인")
        return result | {"checked_at": time.time()}
    except WalletLocked as exc:
        return base | {"code": "wallet_locked", "message": str(exc), "checked_at": time.time()}
    except (RuntimeError, KeyError, TypeError, ValueError, OSError, subprocess.SubprocessError) as exc:
        return base | {"code": "query_error", "message": str(exc), "attempted_at": time.time()}


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--test-sat", type=int, default=10)
    parser.add_argument("--fee-limit-sat", type=int, default=10)
    args = parser.parse_args(argv)
    result = snapshot(args.test_sat, args.fee_limit_sat)
    code = 0 if result["complete"] else 1 if result["code"] in ("query_error", "wrong_network") else 10
    if args.json:
        print(json.dumps(result, ensure_ascii=False))
    else:
        print(f"{'OK' if code == 0 else 'FAIL' if code == 1 else 'ACTION'}: {result['message']}",
              file=sys.stdout if code == 0 else sys.stderr)
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
