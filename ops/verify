#!/usr/bin/env bash
set -euo pipefail

profile=${1:-}
case "$profile" in
  regtest) nodes=2 ;;
  testnet) nodes=1 ;;
  *) echo 'Usage: ops/verify regtest|testnet' >&2; exit 2 ;;
esac
export KUBECONFIG=${KUBECONFIG:-${XDG_STATE_HOME:-$HOME/.local/state}/lnd-ops/kubeconfig}
namespace=lnd-$profile

kubectl -n "$namespace" get serviceaccount lnd-node -o jsonpath='{.automountServiceAccountToken}' | grep -Fxq false
kubectl -n "$namespace" get networkpolicy default-deny allow-dns >/dev/null
kubectl -n "$namespace" get namespace "$namespace" -o jsonpath='{.metadata.labels.pod-security\.kubernetes\.io/enforce}' | grep -Fxq baseline

if [[ "$profile" == regtest ]]; then
  kubectl -n "$namespace" get serviceaccount bitcoin-node -o jsonpath='{.automountServiceAccountToken}' | grep -Fxq false
  kubectl -n "$namespace" get networkpolicy lnd-peer-traffic lnd-to-bitcoin lnd-bitcoin-egress >/dev/null
  kubectl -n "$namespace" rollout status statefulset/bitcoin --timeout=5m
  kubectl -n "$namespace" exec bitcoin-0 -- bitcoin-cli -regtest \
    -rpcuser=regtest -rpcpassword=local-regtest-only getblockchaininfo | \
    python3 -c 'import json,sys; assert json.load(sys.stdin)["chain"] == "regtest"'
fi
if [[ "$profile" == testnet ]]; then
  kubectl -n "$namespace" get networkpolicy testnet-public-traffic >/dev/null
fi

pending=0
for ((i=0; i<nodes; i++)); do
  name=lnd-$i
  kubectl -n "$namespace" rollout status "statefulset/$name" --timeout=5m
  kubectl -n "$namespace" get pvc "data-$name-0" >/dev/null
  if ! kubectl -n "$namespace" exec "$name-0" -- test -f "/data/.lnd/data/chain/bitcoin/$profile/admin.macaroon" >/dev/null 2>&1; then
    echo "ACTION $name: create and unlock the $profile wallet; record its seed offline"
    pending=1
    continue
  fi
  info=$(kubectl -n "$namespace" exec "$name-0" -c lnd -- \
    lncli --lnddir=/data/.lnd --network="$profile" getinfo 2>/dev/null || true)
  if ! python3 -c 'import json,sys; data=json.load(sys.stdin); assert data["identity_pubkey"]' \
      <<<"$info" >/dev/null 2>&1; then
    echo "ACTION $name: unlock wallet or inspect LND logs"
    pending=1
  else
    echo "OK $name: wallet unlocked and node identity available"
  fi
done

if (( pending )); then
  echo 'Infrastructure checks passed; wallet gate pending' >&2
  exit 10
fi
echo "OK $profile infrastructure and wallets"
