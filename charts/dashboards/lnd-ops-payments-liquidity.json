{
  "uid": "lnd-ops-payments-liquidity",
  "title": "LND Ops / Payments and Liquidity",
  "tags": [
    "lnd-ops",
    "lightning"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Can receive 10,000 sat on one active channel",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (namespace, service) (lnd_channels_bandwidth_incoming_sat{status=\"active\"}) >= bool 10000",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Can send 10,000 sat on one active channel",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max by (namespace, service) (lnd_channels_bandwidth_outgoing_sat{status=\"active\"}) >= bool 10000",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Aggregate inbound liquidity (sat)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (namespace, service) (lnd_channels_bandwidth_incoming_sat{status=\"active\"})",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Aggregate outbound liquidity (sat)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (namespace, service) (lnd_channels_bandwidth_outgoing_sat{status=\"active\"})",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Outgoing payment outcomes, last hour",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (namespace, service, status) (increase(lnd_total_payments[1h]))",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "HTLC attempts by payment outcome, last hour",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (namespace, service, status) (increase(lnd_total_htlc_attempts[1h]))",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 7,
      "title": "Outgoing payment fees, last hour (sat)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "lnd_ops_outgoing_fee_sat_1h",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}}"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 8,
      "title": "Outgoing payment latency, last hour (s)",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "lnd_ops_outgoing_latency_seconds_sum_1h / clamp_min(lnd_ops_outgoing_latency_samples_1h, 1)",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}}"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 9,
      "title": "Settled incoming invoices, last hour",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "lnd_ops_received_invoices_1h{state=\"SETTLED\"}",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}}"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 10,
      "title": "Outgoing payments by current status, last hour",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "lnd_ops_outgoing_payments_1h",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}} {{status}}"
        }
      ]
    }
  ]
}
