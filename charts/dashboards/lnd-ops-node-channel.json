{
  "uid": "lnd-ops-node-channel",
  "title": "LND Ops / Node and Channels",
  "tags": [
    "lnd-ops",
    "lightning"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Chain synced",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "lnd_chain_synced",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Graph synced",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "lnd_graph_synced",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Best block age",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "time() - lnd_chain_block_timestamp",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Connected peers",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "lnd_peer_count",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Active channels",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "lnd_channels_active_total",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Inactive channels",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "lnd_channels_inactive_total",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Per-channel inbound (sat)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "lnd_channels_bandwidth_incoming_sat",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}} chan {{chan_id}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Per-channel outbound (sat)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "lnd_channels_bandwidth_outgoing_sat",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{service}} chan {{chan_id}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {"id": 9, "title": "Pending channels", "type": "timeseries", "gridPos": {"x": 0, "y": 22, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "lnd_channels_pending_total", "legendFormat": "{{namespace}}/{{service}}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 10, "title": "Pending HTLCs", "type": "timeseries", "gridPos": {"x": 8, "y": 22, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (namespace, service) (lnd_channels_pending_htlc_count)", "legendFormat": "{{namespace}}/{{service}}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 11, "title": "Open channel balance", "type": "timeseries", "gridPos": {"x": 16, "y": 22, "w": 8, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (namespace, service) (lnd_channels_open_balance_sat)", "legendFormat": "{{namespace}}/{{service}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
    {"id": 12, "title": "Confirmed on-chain wallet balance", "type": "timeseries", "gridPos": {"x": 0, "y": 30, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "lnd_wallet_balance_confirmed_sat", "legendFormat": "{{namespace}}/{{service}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
    {"id": 13, "title": "LND and lndmon scrape health", "type": "timeseries", "gridPos": {"x": 12, "y": 30, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "up{job=~\"lnd-grpc|lndmon\"}", "legendFormat": "{{job}} {{namespace}}/{{service}}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []}}
  ]
}
