{
  "uid": "lnd-ops-kubernetes",
  "title": "LND Ops / Kubernetes",
  "tags": ["lnd-ops", "kubernetes"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "K3s node Ready",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "id": 2,
      "title": "LND Pods not Ready",
      "type": "stat",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(kube_pod_status_ready{namespace=~\"lnd-regtest|lnd-testnet\",condition=\"false\"}) or vector(0)", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "id": 3,
      "title": "Guest filesystem available bytes",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 7, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "node_filesystem_avail_bytes{mountpoint=\"/\"}", "legendFormat": "{{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "id": 4,
      "title": "Monitoring scrape targets up",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 7, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (job) (up{job=~\"node-exporter|kube-state-metrics\"})", "legendFormat": "{{job}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0}, "overrides": []}
    },
    {"id": 5, "title": "LND Pod CPU cores", "type": "timeseries", "gridPos": {"x": 0, "y": 15, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{namespace=~\"lnd-regtest|lnd-testnet\",container!=\"\",image!=\"\"}[5m]))", "legendFormat": "{{namespace}}/{{pod}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "cores"}, "overrides": []}},
    {"id": 6, "title": "LND Pod memory working set", "type": "timeseries", "gridPos": {"x": 12, "y": 15, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (namespace, pod) (container_memory_working_set_bytes{namespace=~\"lnd-regtest|lnd-testnet\",container!=\"\",image!=\"\"})", "legendFormat": "{{namespace}}/{{pod}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}},
    {"id": 7, "title": "LND PVC utilization", "type": "timeseries", "gridPos": {"x": 0, "y": 23, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "1 - kubelet_volume_stats_available_bytes{namespace=~\"lnd-regtest|lnd-testnet\"} / kubelet_volume_stats_capacity_bytes{namespace=~\"lnd-regtest|lnd-testnet\"}", "legendFormat": "{{namespace}}/{{persistentvolumeclaim}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}},
    {"id": 8, "title": "Container restarts", "type": "timeseries", "gridPos": {"x": 12, "y": 23, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (namespace, pod) (kube_pod_container_status_restarts_total{namespace=~\"lnd-regtest|lnd-testnet\"})", "legendFormat": "{{namespace}}/{{pod}}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0}, "overrides": []}},
    {"id": 9, "title": "Node pressure conditions", "type": "timeseries", "gridPos": {"x": 0, "y": 31, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "max by (node, condition) (kube_node_status_condition{condition=~\"DiskPressure|MemoryPressure|PIDPressure\",status=\"true\"})", "legendFormat": "{{node}} {{condition}}", "refId": "A"}], "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []}},
    {"id": 10, "title": "StatefulSet ready ratio", "type": "timeseries", "gridPos": {"x": 12, "y": 31, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "kube_statefulset_status_replicas_ready{namespace=~\"lnd-regtest|lnd-testnet\"} / clamp_min(kube_statefulset_replicas{namespace=~\"lnd-regtest|lnd-testnet\"}, 1)", "legendFormat": "{{namespace}}/{{statefulset}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}}
  ]
}
