{
  "uid": "opencti-l402",
  "title": "OpenCTI / L402 Payment Gate",
  "description": "Same queries as the paid-scan-diagnosis agent and the OpenCTIL402* alerts. Playbook: docs/playbooks/opencti-l402-funnel.md",
  "tags": [
    "opencti",
    "l402",
    "aperture"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Is it up? (SLO)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Probe: all components up",
      "description": "Playbook signal probe_components (pricer, lnd_merchant, aperture); 1 = every component passes.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "l402_probe:up",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Burn rate 1h",
      "description": "Playbook signal probe_burn_1h. Fast burn pages when BOTH the 1h and 5m burn rates are at least 14.4.",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "l402_probe:error_ratio_1h / 0.005",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Burn rate 5m",
      "description": "Playbook signal probe_burn_5m. Fast burn pages when BOTH the 1h and 5m burn rates are at least 14.4.",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "l402_probe:error_ratio_5m / 0.005",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Error budget left (30d)",
      "description": "SLO 99.5% over 30 days (docs/slo-l402.md); negative means the budget is spent.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "1 - (1 - avg_over_time(l402_probe:up[30d])) / 0.005",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.25
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "L402 alerts firing",
      "description": "Count of firing OpenCTIL402* alerts (Alertmanager UI is the only delivery channel).",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertname=~\"OpenCTIL402.*\",alertstate=\"firing\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 7,
      "title": "Probe success by component",
      "description": "Playbook signal probe_components: which of pricer, lnd_merchant, aperture is failing.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "probe_success{job=\"l402-probe\"}",
          "refId": "A",
          "legendFormat": "{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Burn rate by window",
      "description": "Playbook signals probe_burn_*: fast burn pages at 14.4 (5m and 1h), slow burn warns at 6 (30m and 6h).",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "l402_probe:error_ratio_5m / 0.005",
          "refId": "A",
          "legendFormat": "5m"
        },
        {
          "expr": "l402_probe:error_ratio_30m / 0.005",
          "refId": "B",
          "legendFormat": "30m"
        },
        {
          "expr": "l402_probe:error_ratio_1h / 0.005",
          "refId": "C",
          "legendFormat": "1h"
        },
        {
          "expr": "l402_probe:error_ratio_6h / 0.005",
          "refId": "D",
          "legendFormat": "6h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Funnel (last 15 minutes, same as diagnose_l402_funnel)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "title": "Requests without token",
      "description": "Playbook funnel field no_credentials: requests that arrived without an L402 token.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(aperture_l402_verify_total{job=\"aperture\",reason=\"missing_credentials\"}[15m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 11,
      "title": "Invoices issued",
      "description": "Playbook funnel field mint_ok: challenges issued (invoices minted).",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 14,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(aperture_l402_mint_total{job=\"aperture\",result=\"ok\"}[15m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 12,
      "title": "Accepted",
      "description": "Playbook funnel field accepted: requests admitted with proof of payment.",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(aperture_l402_verify_total{job=\"aperture\",reason=\"accepted\"}[15m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 13,
      "title": "Awaiting payment",
      "description": "Playbook funnel field unsettled: token presented but invoice not settled yet.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(aperture_l402_verify_total{job=\"aperture\",reason=\"invoice_state_mismatch\"}[15m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 14,
      "title": "Mint failures",
      "description": "Playbook funnel field mint_failed:<result>; any value pages OpenCTIL402InvoiceIssuanceFailing.",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (result) (increase(aperture_l402_mint_total{job=\"aperture\",result!=\"ok\"}[15m]))",
          "refId": "A",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 15,
      "title": "Secret store errors",
      "description": "Playbook funnel field lookup_error (secret_store_error); any value pages OpenCTIL402SecretStoreFailing.",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 14,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(aperture_l402_verify_total{job=\"aperture\",reason=\"secret_store_error\"}[15m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 16,
      "title": "Funnel over time (15m windows)",
      "description": "Same 15m sliding-window increase() as the tool and alerts. With low traffic and integer counters the line steps up and lags (sawtooth); it is not noise.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(aperture_l402_verify_total{job=\"aperture\",reason=\"missing_credentials\"}[15m]))",
          "refId": "A",
          "legendFormat": "no token"
        },
        {
          "expr": "sum(increase(aperture_l402_mint_total{job=\"aperture\",result=\"ok\"}[15m]))",
          "refId": "B",
          "legendFormat": "invoices issued"
        },
        {
          "expr": "sum(increase(aperture_l402_verify_total{job=\"aperture\",reason=\"accepted\"}[15m]))",
          "refId": "C",
          "legendFormat": "accepted"
        },
        {
          "expr": "sum(increase(aperture_l402_verify_total{job=\"aperture\",reason=\"invoice_state_mismatch\"}[15m]))",
          "refId": "D",
          "legendFormat": "awaiting payment"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 17,
      "title": "Security signal (never changes the verdict)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 18,
      "title": "Rejected tokens by reason (15m)",
      "description": "Playbook security signal rejected:<reason>; informational only, never changes the verdict.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(aperture_l402_verify_total{job=\"aperture\",reason=~\"payment_proof_mismatch|invalid_signature|malformed_credentials|malformed_identifier|unknown_credential|restriction_failure\"}[15m]))",
          "refId": "A",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 19,
      "title": "Rejected per 15m, 24h baseline",
      "description": "Playbook security baseline. Elevated = at least 20 rejections (SECURITY_MIN) AND at least 10x this baseline (SECURITY_FACTOR).",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 27,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(aperture_l402_verify_total{job=\"aperture\",reason=~\"payment_proof_mismatch|invalid_signature|malformed_credentials|malformed_identifier|unknown_credential|restriction_failure\"}[1d] offset 15m)) / 96",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 20,
      "title": "Is it observed?",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 21,
      "title": "Aperture metrics scraped",
      "description": "Playbook signal aperture_not_scraped: 0 means the funnel numbers cannot be trusted.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(up{job=\"aperture\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 22,
      "title": "Probe scraped",
      "description": "Playbook signal probe_not_scraped: expects 3 components (pricer, lnd_merchant, aperture).",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(probe_success{job=\"l402-probe\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    }
  ]
}
